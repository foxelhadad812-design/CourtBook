# ==============================================================================
# CourtBook.Web — Multi-stage Container Build
# ==============================================================================

# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

# Copy project definition files for layer caching
COPY src/CourtBook.Domain/CourtBook.Domain.csproj src/CourtBook.Domain/
COPY src/CourtBook.Application/CourtBook.Application.csproj src/CourtBook.Application/
COPY src/CourtBook.Web/CourtBook.Web.csproj src/CourtBook.Web/

# Restore dependencies
RUN dotnet restore src/CourtBook.Web/CourtBook.Web.csproj

# Copy source tree and publish
COPY src/CourtBook.Domain/ src/CourtBook.Domain/
COPY src/CourtBook.Application/ src/CourtBook.Application/
COPY src/CourtBook.Web/ src/CourtBook.Web/

WORKDIR /app/src/CourtBook.Web
RUN dotnet publish -c Release -o /app/publish /p:UseAppHost=false

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
EXPOSE 5100

ENV ASPNETCORE_URLS=http://+:5100
ENV ASPNETCORE_ENVIRONMENT=Staging

COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "CourtBook.Web.dll"]
