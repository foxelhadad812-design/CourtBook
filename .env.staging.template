# ==============================================================================
# CourtBook (PlaySpot) — Staging Environment Variables Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to '.env.staging' (do NOT commit '.env.staging' to git).
# 2. Replace all placeholders with valid staging values.
# 3. In staging/production, NEVER commit real credentials, keys, or passwords.
# ==============================================================================

# Core Hosting Environment
ASPNETCORE_ENVIRONMENT=Staging

# ------------------------------------------------------------------------------
# Database Configuration (SQL Server 2019+ or Azure SQL)
# NOTE: Startup validation strictly rejects 'localhost', '127.0.0.1', or '(localdb)'.
# Requires permission for sp_getapplock and sp_releaseapplock.
# ------------------------------------------------------------------------------
ConnectionStrings__DefaultConnection=<STAGING_SQL_CONNECTION_STRING>

# ------------------------------------------------------------------------------
# JWT Authentication Settings
# NOTE: Key must be >= 32 characters (256-bit). Known dev/staging placeholders
# will fail startup validation.
# ------------------------------------------------------------------------------
JwtSettings__Key=<STAGING_JWT_SECRET>
JwtSettings__Issuer=https://<STAGING_API_HOSTNAME>
JwtSettings__Audience=https://<STAGING_WEB_HOSTNAME>

# ------------------------------------------------------------------------------
# Payment Gateway (Paymob Sandbox/Staging Credentials)
# NOTE: Live Paymob validation requires real staging merchant credentials.
# ------------------------------------------------------------------------------
PaymentGateway__Paymob__IsSandbox=true
PaymentGateway__Paymob__ApiKey=<STAGING_PAYMOB_API_KEY>
PaymentGateway__Paymob__IntegrationId=<STAGING_PAYMOB_INTEGRATION_ID>
PaymentGateway__Paymob__IframeId=<STAGING_PAYMOB_IFRAME_ID>
PaymentGateway__Paymob__HmacSecret=<STAGING_PAYMOB_HMAC_SECRET>

# ------------------------------------------------------------------------------
# Redis Cache & SignalR Backplane (Optional for Single-Instance Staging)
# If running multi-instance API/Web containers, provide a valid Redis instance.
# ------------------------------------------------------------------------------
Redis__ConnectionString=<STAGING_REDIS_CONNECTION_STRING>

# ------------------------------------------------------------------------------
# Health Checks & Diagnostic Telemetry
# Secret API key required to access /health/details remotely in Staging.
# ------------------------------------------------------------------------------
HealthChecks__DetailsApiKey=<STAGING_HEALTH_DETAILS_API_KEY>

# ------------------------------------------------------------------------------
# Reverse Proxy & Network Security (ForwardedHeaders)
# List trusted CIDR subnets or proxy IPs to prevent header spoofing.
# ------------------------------------------------------------------------------
ForwardedHeaders__KnownNetworks__0=10.0.0.0/16
# ForwardedHeaders__KnownProxies__0=<STAGING_PROXY_IP>

# ------------------------------------------------------------------------------
# Web Frontend Configuration (CourtBook.Web)
# ------------------------------------------------------------------------------
ApiSettings__BaseUrl=https://<STAGING_API_HOSTNAME>
AllowedOrigins__0=https://<STAGING_WEB_HOSTNAME>
OpenApi__EnableInProduction=false
