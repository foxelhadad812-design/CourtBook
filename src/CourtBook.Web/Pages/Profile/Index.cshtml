@page "/Profile"
@model CourtBook.Web.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "My Profile";
    var p = Model.Profile;
    var initials = "PS";
    if (p != null && !string.IsNullOrWhiteSpace(p.Name))
    {
        var parts = p.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = parts.Length >= 2 
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper() 
            : p.Name[..Math.Min(2, p.Name.Length)].ToUpper();
    }

    var allCities = new[] { "Cairo", "Giza", "Alexandria", "New Cairo", "6th of October", "Sheikh Zayed", "Maadi", "Zamalek", "Nasr City", "Heliopolis" };
    var allDays = new[] { "Saturday", "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" };
    var allTimes = new[] { "Morning", "Afternoon", "Evening", "Night" };
}

<div class="container py-4 py-md-5">
    <!-- Feedback Alerts -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
            <div>@Model.SuccessMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill text-danger fs-5 me-2"></i>
            <div>@Model.ErrorMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (p != null)
    {
        <!-- Profile Showcase Hero Card -->
        <div class="card bg-dark border-secondary border-opacity-25 shadow-sm rounded-4 p-4 mb-4">
            <div class="d-flex flex-column flex-md-row align-items-center gap-4 text-center text-md-start">
                <!-- Avatar Initials Badge -->
                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold fs-2 text-black shadow"
                     style="width: 88px; height: 88px; background: linear-gradient(135deg, var(--ps-primary, #00e5ff) 0%, #3b82f6 100%);">
                    @initials
                </div>

                <!-- Identity Details -->
                <div class="flex-grow-1">
                    <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-2 mb-1">
                        <h2 class="h3 fw-bold text-light mb-0">@p.Name</h2>
                        <span class="badge bg-primary bg-opacity-20 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1 small">
                            <i class="bi bi-person-badge me-1"></i>@p.Role
                        </span>
                        @if (!string.IsNullOrWhiteSpace(p.SkillLevel))
                        {
                            <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-25 rounded-pill px-3 py-1 small">
                                <i class="bi bi-award me-1 text-warning"></i>@p.SkillLevel
                            </span>
                        }
                    </div>

                    <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-3 text-muted small mt-2">
                        <span><i class="bi bi-envelope me-1 text-primary"></i>@p.Email</span>
                        @if (!string.IsNullOrWhiteSpace(p.Phone))
                        {
                            <span><i class="bi bi-telephone me-1 text-primary"></i>@p.Phone</span>
                        }
                        <span><i class="bi bi-calendar-check me-1 text-primary"></i>Member since @p.MemberSince.ToString("MMM yyyy")</span>
                    </div>
                </div>

                <!-- Navigation Tabs Trigger Buttons -->
                <div class="d-flex gap-2">
                    <a href="/Profile?tab=overview" 
                       class="btn @(Model.ActiveTab == "overview" ? "btn-primary text-black fw-bold" : "btn-outline-light") rounded-pill px-3 btn-sm">
                        <i class="bi bi-person-lines-fill me-1"></i> Overview
                    </a>
                    <a href="/Profile?tab=edit" 
                       class="btn @(Model.ActiveTab == "edit" ? "btn-primary text-black fw-bold" : "btn-outline-light") rounded-pill px-3 btn-sm">
                        <i class="bi bi-pencil-square me-1"></i> Edit Profile
                    </a>
                </div>
            </div>
        </div>

        @if (Model.ActiveTab == "overview")
        {
            <!-- OVERVIEW TAB -->
            <div class="row g-4">
                <!-- Left: Highlights & Preferences -->
                <div class="col-12 col-lg-8">
                    <!-- Key Player Metrics -->
                    <div class="row g-3 mb-4">
                        <div class="col-sm-4">
                            <div class="card bg-dark border-secondary border-opacity-25 shadow-sm rounded-4 p-3 text-center">
                                <div class="text-muted small mb-1">Matches Played</div>
                                <div class="fw-bold fs-3 text-primary">@p.MatchesPlayedCount</div>
                            </div>
                        </div>

                        <div class="col-sm-4">
                            <div class="card bg-dark border-secondary border-opacity-25 shadow-sm rounded-4 p-3 text-center">
                                <div class="text-muted small mb-1">Skill Level</div>
                                <div class="fw-bold fs-4 text-warning">@(string.IsNullOrWhiteSpace(p.SkillLevel) ? "Beginner" : p.SkillLevel)</div>
                            </div>
                        </div>

                        <div class="col-sm-4">
                            <div class="card bg-dark border-secondary border-opacity-25 shadow-sm rounded-4 p-3 text-center">
                                <div class="text-muted small mb-1">Primary Sport</div>
                                <div class="fw-bold fs-4 text-info">@(string.IsNullOrWhiteSpace(p.PreferredSport) ? "Football" : p.PreferredSport)</div>
                            </div>
                        </div>
                    </div>

                    <!-- About / Bio Card -->
                    <div class="card bg-dark border-secondary border-opacity-25 shadow-sm rounded-4 p-4 mb-4">
                        <h5 class="fw-bold text-light mb-3 d-flex align-items-center">
                            <i class="bi bi-card-text text-primary me-2"></i>About Player
                        </h5>
                        <p class="text-muted mb-0">
                            @(string.IsNullOrWhiteSpace(p.Bio) ? "No player bio added yet. Click 'Edit Profile' to share your favorite playing style, position, or team preferences." : p.Bio)
                        </p>
                    </div>

                    <!-- Player Match Preferences Card -->
                    <div class="card bg-dark border-secondary border-opacity-25 shadow-sm rounded-4 p-4">
                        <h5 class="fw-bold text-light mb-3 d-flex align-items-center">
                            <i class="bi bi-sliders text-primary me-2"></i>Match & Facility Preferences
                        </h5>

                        <div class="mb-3">
                            <div class="text-muted small mb-2 fw-semibold">Preferred Locations & Cities:</div>
                            <div class="d-flex flex-wrap gap-2">
                                @if (p.Preferences?.PreferredCities?.Any() == true)
                                {
                                    @foreach (var city in p.Preferences.PreferredCities)
                                    {
                                        <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-25 px-3 py-2 rounded-pill small">
                                            <i class="bi bi-geo-alt me-1 text-primary"></i>@city
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">No location preferences set (defaults to Cairo).</span>
                                }
                            </div>
                        </div>

                        <div class="mb-3 pt-3 border-top border-secondary border-opacity-10">
                            <div class="text-muted small mb-2 fw-semibold">Preferred Playing Days:</div>
                            <div class="d-flex flex-wrap gap-2">
                                @if (p.Preferences?.PreferredDays?.Any() == true)
                                {
                                    @foreach (var day in p.Preferences.PreferredDays)
                                    {
                                        <span class="badge bg-primary bg-opacity-15 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill small">
                                            <i class="bi bi-calendar-event me-1"></i>@day
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">No preferred days set.</span>
                                }
                            </div>
                        </div>

                        <div class="pt-3 border-top border-secondary border-opacity-10">
                            <div class="text-muted small mb-2 fw-semibold">Preferred Playing Time of Day:</div>
                            <div class="d-flex flex-wrap gap-2">
                                @if (p.Preferences?.PreferredTimeOfDay?.Any() == true)
                                {
                                    @foreach (var time in p.Preferences.PreferredTimeOfDay)
                                    {
                                        <span class="badge bg-warning bg-opacity-15 text-warning border border-warning border-opacity-25 px-3 py-2 rounded-pill small">
                                            <i class="bi bi-brightness-high me-1"></i>@time
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">No preferred times set.</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right: Quick Actions & Account Info -->
                <div class="col-12 col-lg-4">
                    <!-- Quick Navigation -->
                    <div class="card bg-dark border-secondary border-opacity-25 shadow-sm rounded-4 p-4 mb-4">
                        <h5 class="fw-bold text-light mb-3">Quick Actions</h5>
                        <div class="d-grid gap-2">
                            <a href="/Bookings?status=upcoming" class="btn btn-outline-primary text-start rounded-pill py-2">
                                <i class="bi bi-calendar2-check me-2"></i> View Upcoming Bookings
                            </a>
                            <a href="/Bookings?status=completed" class="btn btn-outline-light text-start rounded-pill py-2">
                                <i class="bi bi-clock-history me-2"></i> Match History
                            </a>
                            <a href="/Venues" class="btn btn-primary text-black fw-bold text-start rounded-pill py-2">
                                <i class="bi bi-search me-2"></i> Book a Court
                            </a>
                        </div>
                    </div>

                    <!-- Account Details Card -->
                    <div class="card bg-dark border-secondary border-opacity-25 shadow-sm rounded-4 p-4">
                        <h5 class="fw-bold text-light mb-3 d-flex align-items-center">
                            <i class="bi bi-shield-check text-primary me-2"></i>Account Security
                        </h5>

                        <div class="bg-black bg-opacity-25 rounded-3 p-3 border border-secondary border-opacity-10 small mb-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Account Type:</span>
                                <span class="text-light fw-bold">@p.Role</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Player ID:</span>
                                <span class="text-muted font-monospace small">@p.UserId.ToString()[..8]...</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Email Verified:</span>
                                <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Yes</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-10">
                            <a href="/Logout" class="text-danger small text-decoration-none fw-semibold">
                                <i class="bi bi-box-arrow-right me-1"></i> Sign out of account
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- EDIT PROFILE & PREFERENCES TAB -->
            <div class="card bg-dark border-secondary border-opacity-25 shadow-sm rounded-4 p-4 p-md-5">
                <div class="mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                    <h3 class="fw-bold text-light mb-1">Edit Profile & Player Preferences</h3>
                    <p class="text-muted small mb-0">Update your personal details, playing preferences, and notification settings.</p>
                </div>

                <form method="post" asp-page-handler="Update" id="editProfileForm">
                    <div class="row g-4 mb-4">
                        <!-- Full Name -->
                        <div class="col-md-6">
                            <label asp-for="Form.Name" class="form-label text-light fw-semibold small">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="Form.Name" class="form-control bg-dark text-light border-secondary border-opacity-50 py-2 rounded-3" placeholder="Enter your full name" required />
                            <span asp-validation-for="Form.Name" class="text-danger small"></span>
                        </div>

                        <!-- Phone Number -->
                        <div class="col-md-6">
                            <label asp-for="Form.Phone" class="form-label text-light fw-semibold small">Phone Number</label>
                            <input asp-for="Form.Phone" class="form-control bg-dark text-light border-secondary border-opacity-50 py-2 rounded-3" placeholder="e.g. 01012345678" />
                            <span asp-validation-for="Form.Phone" class="text-danger small"></span>
                        </div>

                        <!-- Bio -->
                        <div class="col-12">
                            <label asp-for="Form.Bio" class="form-label text-light fw-semibold small">Player Bio</label>
                            <textarea asp-for="Form.Bio" class="form-control bg-dark text-light border-secondary border-opacity-50 rounded-3" rows="3" placeholder="Share a few words about your sports experience, favorite position, or playing style..."></textarea>
                            <span asp-validation-for="Form.Bio" class="text-danger small"></span>
                        </div>

                        <!-- Skill Level -->
                        <div class="col-md-6">
                            <label asp-for="Form.SkillLevel" class="form-label text-light fw-semibold small">Skill Level</label>
                            <select asp-for="Form.SkillLevel" class="form-select bg-dark text-light border-secondary border-opacity-50 py-2 rounded-3">
                                <option value="Beginner">Beginner (مبتدئ)</option>
                                <option value="Intermediate">Intermediate (متوسط)</option>
                                <option value="Advanced">Advanced (متقدم)</option>
                                <option value="Professional">Professional (محترف)</option>
                            </select>
                        </div>

                        <!-- Preferred Sport -->
                        <div class="col-md-6">
                            <label asp-for="Form.PreferredSport" class="form-label text-light fw-semibold small">Primary Sport</label>
                            <select asp-for="Form.PreferredSport" class="form-select bg-dark text-light border-secondary border-opacity-50 py-2 rounded-3">
                                <option value="Football">⚽ Football</option>
                                <option value="Padel">🎾 Padel</option>
                                <option value="Tennis">🎾 Tennis</option>
                                <option value="Basketball">🏀 Basketball</option>
                                <option value="Squash">🏸 Squash</option>
                                <option value="Swimming">🏊 Swimming</option>
                            </select>
                        </div>
                    </div>

                    <!-- PREFERENCES SECTION -->
                    <div class="mb-4 pt-3 border-top border-secondary border-opacity-25">
                        <h5 class="fw-bold text-primary mb-3">Player Match Preferences</h5>

                        <!-- Preferred Cities -->
                        <div class="mb-4">
                            <label class="form-label text-light fw-semibold small mb-2">Preferred Cities / Areas:</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var city in allCities)
                                {
                                    var isChecked = Model.Form.PreferredCities?.Contains(city, StringComparer.OrdinalIgnoreCase) == true;
                                    <div class="form-check-pill">
                                        <input type="checkbox" name="Form.PreferredCities" value="@city" id="city_@city" class="btn-check" @(isChecked ? "checked" : "") />
                                        <label class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1" for="city_@city">
                                            <i class="bi bi-geo-alt me-1"></i>@city
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Preferred Days -->
                        <div class="mb-4">
                            <label class="form-label text-light fw-semibold small mb-2">Preferred Playing Days:</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var day in allDays)
                                {
                                    var isChecked = Model.Form.PreferredDays?.Contains(day, StringComparer.OrdinalIgnoreCase) == true;
                                    <div class="form-check-pill">
                                        <input type="checkbox" name="Form.PreferredDays" value="@day" id="day_@day" class="btn-check" @(isChecked ? "checked" : "") />
                                        <label class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1" for="day_@day">
                                            <i class="bi bi-calendar-check me-1"></i>@day
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Preferred Times of Day -->
                        <div class="mb-3">
                            <label class="form-label text-light fw-semibold small mb-2">Preferred Times of Day:</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var time in allTimes)
                                {
                                    var isChecked = Model.Form.PreferredTimeOfDay?.Contains(time, StringComparer.OrdinalIgnoreCase) == true;
                                    <div class="form-check-pill">
                                        <input type="checkbox" name="Form.PreferredTimeOfDay" value="@time" id="time_@time" class="btn-check" @(isChecked ? "checked" : "") />
                                        <label class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1" for="time_@time">
                                            <i class="bi bi-clock me-1"></i>@time
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary border-opacity-25">
                        <a href="/Profile?tab=overview" class="btn btn-secondary rounded-pill px-4">Cancel</a>
                        <button type="submit" id="btnSaveProfile" class="btn btn-primary text-black fw-bold rounded-pill px-4">
                            <i class="bi bi-check2 me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        }
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('editProfileForm');
            if (form) {
                form.addEventListener('submit', () => {
                    const btn = document.getElementById('btnSaveProfile');
                    if (btn) {
                        btn.disabled = true;
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Saving...';
                    }
                });
            }
        });
    </script>
}
