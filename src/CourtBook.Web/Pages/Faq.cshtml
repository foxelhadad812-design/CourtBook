@page
@{
    ViewData["Title"] = "FAQ";
}

<div class="container py-5 my-4">
    <div class="text-center mb-5">
        <h2 class="section-title">Frequently Asked Questions</h2>
        <p class="text-muted">Find answers to the most common questions about CourtBook.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="accordion shadow-sm" id="faqAccordion">
                
                <div class="accordion-item border-0 mb-3 rounded overflow-hidden">
                    <h2 class="accordion-header">
                        <button class="accordion-button bg-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                            How do I book a court?
                        </button>
                    </h2>
                    <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Simply create a Client account, search for a venue in your city, and select a court. Pick an available date and time slot, then click "Confirm Booking". It's instant and requires no phone calls!
                        </div>
                    </div>
                </div>

                <div class="accordion-item border-0 mb-3 rounded overflow-hidden">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                            Can I cancel my booking?
                        </button>
                    </h2>
                    <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Yes, you can cancel your booking directly from the "My Bookings" page. Cancellations must be made at least 2 hours before the booking start time to be valid.
                        </div>
                    </div>
                </div>

                <div class="accordion-item border-0 mb-3 rounded overflow-hidden">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                            How far in advance can I book?
                        </button>
                    </h2>
                    <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            You can book courts up to 30 days in advance. Popular slots, especially evenings and weekends, tend to get booked quickly, so we recommend booking early.
                        </div>
                    </div>
                </div>

                <div class="accordion-item border-0 mb-3 rounded overflow-hidden">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                            What payment methods are accepted?
                        </button>
                    </h2>
                    <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Currently, we operate on a "pay at the venue" model. You secure your slot online and pay in cash or via card directly at the facility reception. Online payments will be introduced soon!
                        </div>
                    </div>
                </div>

                <div class="accordion-item border-0 mb-3 rounded overflow-hidden">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">
                            How do I list my venue on CourtBook?
                        </button>
                    </h2>
                    <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            You can sign up as an "Owner" on our platform. Once registered, access the Owner Dashboard to add your venue details, upload courts, and set their working hours instantly.
                        </div>
                    </div>
                </div>
                
                <div class="accordion-item border-0 mb-3 rounded overflow-hidden">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq6">
                            What happens if the court is unavailable?
                        </button>
                    </h2>
                    <div id="faq6" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Our system prevents double-booking. If someone has already booked a time slot, the system will not allow another booking and will show an error message. Your booking is 100% guaranteed once confirmed.
                        </div>
                    </div>
                </div>
                
                <div class="accordion-item border-0 mb-3 rounded overflow-hidden">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq7">
                            Is my personal information safe?
                        </button>
                    </h2>
                    <div id="faq7" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Absolutely. We encrypt all sensitive data and passwords using industry-standard hashing algorithms (BCrypt). We never share your personal information with third-party marketers.
                        </div>
                    </div>
                </div>
                
                <div class="accordion-item border-0 mb-3 rounded overflow-hidden">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq8">
                            How do I contact support?
                        </button>
                    </h2>
                    <div id="faq8" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            You can reach out to us via the Contact Us page, send an email to support@courtbook.dev, or call our customer service hotline at +1 (555) 123-4567 during business hours.
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
