@page "/Bookings"
@model CourtBook.Web.Pages.Bookings.IndexModel
@{
    ViewData["Title"] = $"{Loc["Bookings.Title"]} — {Loc["Brand.Name"]}";
    var activeStatus = (Model.Status ?? "upcoming").ToLowerInvariant();
}

<div class="container py-4 py-md-5">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h1 class="h2 fw-bold mb-1 text-dark">
                <i class="bi bi-calendar2-check text-primary me-2"></i>@Loc["Bookings.Title"]
            </h1>
            <p class="text-muted mb-0 small">@Loc["Bookings.Subtitle"]</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/venues" class="ps-btn ps-btn-primary ps-btn-sm">
                <i class="bi bi-search me-1"></i> @Loc["Details.BookCourtCta"]
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
            <div>@Model.SuccessMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill text-danger fs-5 me-2"></i>
            <div>@Model.ErrorMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabs & Filter Bar -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: var(--ps-radius-xl);">
        <div class="card-body p-3">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-stretch align-items-md-center gap-3">
                <!-- Status Navigation Pills -->
                <div class="nav nav-pills gap-1 flex-nowrap overflow-x-auto pb-1 pb-md-0" role="tablist">
                    <a href="/Bookings?status=upcoming&sport=@Model.Sport" 
                       class="nav-link @(activeStatus == "upcoming" ? "active bg-primary" : "text-muted") py-1 px-3 rounded-pill text-nowrap fw-semibold small">
                        <i class="bi bi-clock me-1"></i> @Loc.T("Bookings.Tab.Upcoming", "")
                    </a>
                    <a href="/Bookings?status=completed&sport=@Model.Sport" 
                       class="nav-link @(activeStatus == "completed" ? "active bg-primary" : "text-muted") py-1 px-3 rounded-pill text-nowrap fw-semibold small">
                        <i class="bi bi-check2-circle me-1"></i> @Loc.T("Bookings.Tab.Completed", "")
                    </a>
                    <a href="/Bookings?status=cancelled&sport=@Model.Sport" 
                       class="nav-link @(activeStatus == "cancelled" ? "active bg-primary" : "text-muted") py-1 px-3 rounded-pill text-nowrap fw-semibold small">
                        <i class="bi bi-x-circle me-1"></i> @Loc.T("Bookings.Tab.Cancelled", "")
                    </a>
                    <a href="/Bookings?status=all&sport=@Model.Sport" 
                       class="nav-link @(activeStatus == "all" ? "active bg-primary" : "text-muted") py-1 px-3 rounded-pill text-nowrap fw-semibold small">
                        <i class="bi bi-grid me-1"></i> @Loc.T("Bookings.Tab.All", "")
                    </a>
                </div>

                <!-- Sport Filter -->
                <div class="d-flex align-items-center gap-2">
                    <label for="sportFilter" class="small text-muted text-nowrap mb-0 d-none d-sm-inline">@Loc["Bookings.SportFilter"]:</label>
                    <select id="sportFilter" class="form-select form-select-sm bg-light border-0 fw-medium shadow-none"
                            style="width: 170px;"
                            onchange="window.location.href='/Bookings?status=@activeStatus&sport=' + encodeURIComponent(this.value)">
                        <option value="">@Loc["Home.Search.Sport"]</option>
                        <option value="Football" selected="@(Model.Sport == "Football")">⚽ @Loc.Sport("Football")</option>
                        <option value="Padel" selected="@(Model.Sport == "Padel")">🎾 @Loc.Sport("Padel")</option>
                        <option value="Tennis" selected="@(Model.Sport == "Tennis")">🏸 @Loc.Sport("Tennis")</option>
                        <option value="Basketball" selected="@(Model.Sport == "Basketball")">🏀 @Loc.Sport("Basketball")</option>
                        <option value="Volleyball" selected="@(Model.Sport == "Volleyball")">🏐 @Loc.Sport("Volleyball")</option>
                        <option value="Badminton" selected="@(Model.Sport == "Badminton")">🏸 @Loc.Sport("Badminton")</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Bookings Cards Feed -->
    @if (Model.PagedBookings.Items.Any())
    {
        <div class="row g-4 mb-4">
            @foreach (var b in Model.PagedBookings.Items)
            {
                var isCancelled = b.Status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase);
                var isCompleted = b.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase);
                var isConfirmed = b.Status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase);

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative hover-elevation" style="transition: transform 0.2s, box-shadow 0.2s;">
                        <!-- Top Accent Line -->
                        <div class="position-absolute top-0 start-0 end-0" style="height: 3px; background: @(isConfirmed ? "var(--ps-primary)" : (isCompleted ? "#10B981" : "#EF4444"));"></div>

                        <!-- Card Header -->
                        <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-light text-dark border font-monospace small px-2 py-1">
                                    @b.BookingReference
                                </span>
                            </div>
                            <div>
                                @if (isConfirmed)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success border-opacity-25 rounded-pill px-2 py-1 small">
                                        <i class="bi bi-check-circle me-1"></i>@Loc.BookingStatus(b.Status)
                                    </span>
                                }
                                else if (isCompleted)
                                {
                                    <span class="badge bg-info-subtle text-info border border-info border-opacity-25 rounded-pill px-2 py-1 small">
                                        <i class="bi bi-flag me-1"></i>@Loc.BookingStatus(b.Status)
                                    </span>
                                }
                                else if (isCancelled)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger border-opacity-25 rounded-pill px-2 py-1 small">
                                        <i class="bi bi-x-circle me-1"></i>@Loc.BookingStatus(b.Status)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning border-opacity-25 rounded-pill px-2 py-1 small">
                                        @Loc.BookingStatus(b.Status)
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body p-4">
                            <!-- Venue & Court Title -->
                            <div class="mb-3">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-primary-subtle text-primary px-2 py-0-5 rounded-pill small">
                                        @Loc.Sport(b.SportType)
                                    </span>
                                    <span class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@b.VenueCity</span>
                                </div>
                                <h5 class="card-title fw-bold text-dark mb-0 text-truncate" title="@b.VenueName">
                                    @b.VenueName
                                </h5>
                                <div class="text-muted small fw-medium mt-1">
                                    <i class="bi bi-layout-text-window-reverse me-1 text-primary"></i>@b.CourtName
                                </div>
                            </div>

                            <!-- Schedule Info -->
                            <div class="bg-light rounded-3 p-3 mb-3 border border-light-subtle">
                                <div class="d-flex align-items-center gap-2 text-dark mb-2">
                                    <i class="bi bi-calendar3 text-primary"></i>
                                    <span class="fw-semibold">@b.StartTime.ToString(Loc.IsArabic ? "dddd, dd MMM yyyy" : "dddd, MMM dd, yyyy")</span>
                                </div>
                                <div class="d-flex align-items-center justify-content-between text-muted small">
                                    <div>
                                        <i class="bi bi-clock me-1 text-primary"></i>
                                        <span>@b.StartTime.ToString("HH:mm") - @b.EndTime.ToString("HH:mm")</span>
                                    </div>
                                    <div class="badge bg-light text-dark border px-2 py-1">
                                        @((int)(b.EndTime - b.StartTime).TotalMinutes) @(Loc.IsArabic ? "دقيقة" : "mins")
                                    </div>
                                </div>
                            </div>

                            <!-- Price & Payment State -->
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <div>
                                    <div class="text-muted small">@Loc["Book.Summary.TotalPrice"]</div>
                                    <div class="fw-bold fs-5 text-primary">@Loc.FormatCurrency(b.TotalPrice)</div>
                                </div>
                                <div>
                                    <span class="badge bg-light text-dark border px-2 py-1 small">
                                        <i class="bi bi-credit-card me-1"></i>@Loc.PaymentStatus(b.PaymentStatus)
                                    </span>
                                </div>
                            </div>

                            @if (isCancelled && !string.IsNullOrWhiteSpace(b.CancellationReason))
                            {
                                <div class="mt-3 p-2 rounded bg-danger-subtle border border-danger border-opacity-25 small text-danger">
                                    <i class="bi bi-info-circle me-1"></i><strong>@(Loc.IsArabic ? "سبب الإلغاء:" : "Cancelled:")</strong> @b.CancellationReason
                                </div>
                            }
                        </div>

                        <!-- Card Footer Actions -->
                        <div class="card-footer bg-transparent border-top p-3 d-flex gap-2">
                            <a href="/Bookings/Details?id=@b.Id" class="btn btn-sm btn-outline-secondary flex-grow-1 rounded-pill">
                                <i class="bi bi-info-circle me-1"></i> @Loc["Bookings.Btn.Details"]
                            </a>

                            @if (b.CanCancel)
                            {
                                <button type="button" 
                                        class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                        onclick="openCancelModal('@b.Id', '@b.BookingReference')">
                                    <i class="bi bi-x me-1"></i> @Loc["Bookings.Btn.Cancel"]
                                </button>
                            }
                            else if (b.IsEligibleForReview)
                            {
                                <a href="/Venues/Details?id=@b.VenueId#reviews-section" class="btn btn-sm btn-warning rounded-pill px-3 text-dark fw-medium">
                                    <i class="bi bi-star-fill me-1"></i> @Loc["Bookings.Btn.Review"]
                                </a>
                            }
                            else if (b.HasReviewed)
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning border-opacity-25 d-flex align-items-center px-3 rounded-pill small">
                                    <i class="bi bi-star-fill me-1"></i> @(Loc.IsArabic ? "تم التقييم" : "Reviewed")
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination Controls -->
        @if (Model.PagedBookings.TotalPages > 1)
        {
            <nav aria-label="Bookings navigation" class="mt-4">
                <ul class="pagination justify-content-center gap-1">
                    <li class="page-item @(!Model.PagedBookings.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link border-0 rounded-pill px-3 shadow-none" 
                           href="/Bookings?status=@activeStatus&sport=@Model.Sport&p=@(Model.P - 1)">
                            <i class="bi bi-chevron-left"></i> @Loc["Venues.Pagination.Previous"]
                        </a>
                    </li>

                    @for (int pageIdx = 1; pageIdx <= Model.PagedBookings.TotalPages; pageIdx++)
                    {
                        <li class="page-item @(pageIdx == Model.P ? "active" : "")">
                            <a class="page-link border-0 rounded-circle text-center mx-1 shadow-none @(pageIdx == Model.P ? "bg-primary text-white fw-bold" : "text-dark")"
                               style="width: 38px; height: 38px; line-height: 22px;"
                               href="/Bookings?status=@activeStatus&sport=@Model.Sport&p=@pageIdx">
                                @pageIdx
                            </a>
                        </li>
                    }

                    <li class="page-item @(!Model.PagedBookings.HasNextPage ? "disabled" : "")">
                        <a class="page-link border-0 rounded-pill px-3 shadow-none" 
                           href="/Bookings?status=@activeStatus&sport=@Model.Sport&p=@(Model.P + 1)">
                            @Loc["Venues.Pagination.Next"] <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <!-- Empty States -->
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4">
            <div class="card-body py-4">
                <div class="display-4 text-muted mb-3">
                    @if (activeStatus == "upcoming")
                    {
                        <i class="bi bi-calendar2-x text-primary opacity-50"></i>
                    }
                    else if (activeStatus == "completed")
                    {
                        <i class="bi bi-trophy text-warning opacity-50"></i>
                    }
                    else if (activeStatus == "cancelled")
                    {
                        <i class="bi bi-slash-circle text-danger opacity-50"></i>
                    }
                    else
                    {
                        <i class="bi bi-inbox text-muted opacity-50"></i>
                    }
                </div>

                <h4 class="fw-bold text-dark mb-2">
                    @if (activeStatus == "upcoming")
                    {
                        <span>@Loc["Bookings.Empty.Upcoming"]</span>
                    }
                    else if (activeStatus == "completed")
                    {
                        <span>@Loc["Bookings.Empty.Completed"]</span>
                    }
                    else if (activeStatus == "cancelled")
                    {
                        <span>@Loc["Bookings.Empty.Cancelled"]</span>
                    }
                    else
                    {
                        <span>@Loc["Venues.Empty.Title"]</span>
                    }
                </h4>

                <p class="text-muted mx-auto mb-4" style="max-width: 480px;">
                    @(Loc.IsArabic ? "لا توجد حجوزات تطابق المعايير المختارة حالياً. استكشف المنشآت واحجز موعد مباراتك القادمة الآن." : "You don't have any bookings matching the selected criteria. Explore sports facilities and reserve your match today.")
                </p>

                <a href="/venues" class="ps-btn ps-btn-primary ps-btn-md rounded-pill px-4">
                    <i class="bi bi-search me-1"></i> @Loc["Home.Featured.ViewAll"]
                </a>
            </div>
        </div>
    }
</div>

<!-- Dynamic Cancellation Preview & Confirmation Modal -->
<div class="modal fade" id="cancelBookingModal" tabindex="-1" aria-labelledby="cancelBookingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header pb-3">
                <h5 class="modal-title fw-bold text-danger d-flex align-items-center" id="cancelBookingModalLabel">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i> @Loc["Bookings.CancelModal.Title"]
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-4" id="cancelModalBody">
                <!-- Dynamic Loading Spinner -->
                <div id="cancelModalLoading" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">@(Loc.IsArabic ? "جاري التحقق من السياسة..." : "Loading policy...")</span>
                    </div>
                    <div class="text-muted small mt-2">@(Loc.IsArabic ? "جاري فحص سياسة الإلغاء والاسترداد..." : "Checking cancellation policy...")</div>
                </div>

                <!-- Dynamic Content Container -->
                <div id="cancelModalContent" class="d-none">
                    <div class="mb-3">
                        <div class="text-muted small">@Loc["Confirm.RefLabel"]:</div>
                        <div class="fw-bold font-monospace text-dark fs-5" id="previewRef"></div>
                        <div class="text-muted small mt-1" id="previewVenueCourt"></div>
                    </div>

                    <!-- Policy Banner -->
                    <div id="previewPolicyAlert" class="alert mb-3 border-0 rounded-3 p-3">
                        <div class="d-flex align-items-start">
                            <i id="previewPolicyIcon" class="fs-4 me-2"></i>
                            <div>
                                <strong id="previewPolicyHeadline"></strong>
                                <div id="previewPolicyMessage" class="small mt-1"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Financial Breakdown -->
                    <div class="bg-light rounded-3 p-3 mb-3 border small">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">@Loc["Book.Summary.TotalPrice"]:</span>
                            <span class="fw-bold" id="previewTotalPrice"></span>
                        </div>
                        <div class="d-flex justify-content-between mb-1 text-danger">
                            <span>@Loc["Bookings.CancelModal.FeeAmount"]</span>
                            <span class="fw-bold" id="previewFee"></span>
                        </div>
                        <div class="d-flex justify-content-between pt-2 border-top fs-6 text-success fw-bold">
                            <span>@Loc["Bookings.CancelModal.RefundAmount"]</span>
                            <span id="previewRefund"></span>
                        </div>
                    </div>

                    <form method="post" asp-page-handler="Cancel" id="confirmCancelForm">
                        <input type="hidden" name="id" id="cancelBookingIdInput" />
                        <div class="mb-3">
                            <label for="cancelReasonInput" class="form-label small fw-bold text-dark mb-1">@(Loc.IsArabic ? "سبب الإلغاء (اختياري)" : "Reason for cancellation (optional):")</label>
                            <span class="ps-form-example mb-2">@(Loc.IsArabic ? "مثال: تغيير موعد العمل أو إصابة مفاجئة" : "e.g. Work schedule conflict, unexpected weather, injury")</span>
                            <textarea name="reason" id="cancelReasonInput" class="form-control bg-light border-0 shadow-none small" rows="2" placeholder="@(Loc.IsArabic ? "اكتب سبب الإلغاء هنا لمساعدة المنشأة..." : "e.g. Schedule conflict, weather...")"></textarea>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">@Loc["Bookings.CancelModal.BackBtn"]</button>
                            <button type="submit" id="btnConfirmCancel" class="btn btn-danger rounded-pill px-4 fw-semibold">
                                @Loc["Bookings.CancelModal.ConfirmBtn"]
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Error Container -->
                <div id="cancelModalError" class="alert alert-danger d-none mb-0 small"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let cancelModalInstance = null;

    document.addEventListener('DOMContentLoaded', () => {
        const modalEl = document.getElementById('cancelBookingModal');
        if (modalEl) {
            cancelModalInstance = new bootstrap.Modal(modalEl);
        }

        const confirmForm = document.getElementById('confirmCancelForm');
        if (confirmForm) {
            confirmForm.addEventListener('submit', () => {
                const btn = document.getElementById('btnConfirmCancel');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Cancelling...';
                }
            });
        }
    });

    async function openCancelModal(bookingId, reference) {
        if (!cancelModalInstance) return;

        document.getElementById('cancelModalLoading').classList.remove('d-none');
        document.getElementById('cancelModalContent').classList.add('d-none');
        document.getElementById('cancelModalError').classList.add('d-none');
        document.getElementById('cancelBookingIdInput').value = bookingId;

        cancelModalInstance.show();

        try {
            const resp = await fetch(`/Bookings?handler=CancellationPreview&id=${bookingId}`);
            if (!resp.ok) {
                const err = await resp.json().catch(() => ({ error: 'Failed to fetch policy' }));
                throw new Error(err.error || 'Unable to check cancellation eligibility.');
            }

            const preview = await resp.json();
            renderCancellationPreview(preview);
        } catch (err) {
            document.getElementById('cancelModalLoading').classList.add('d-none');
            const errDiv = document.getElementById('cancelModalError');
            errDiv.textContent = err.message || 'An error occurred checking cancellation rules.';
            errDiv.classList.remove('d-none');
        }
    }

    function renderCancellationPreview(p) {
        document.getElementById('cancelModalLoading').classList.add('d-none');
        document.getElementById('cancelModalContent').classList.remove('d-none');

        document.getElementById('previewRef').textContent = p.bookingReference;
        document.getElementById('previewVenueCourt').textContent = `${p.venueName} • ${p.courtName}`;

        document.getElementById('previewTotalPrice').textContent = `EGP ${p.totalPrice.toFixed(2)}`;
        document.getElementById('previewFee').textContent = `EGP ${p.cancellationFee.toFixed(2)}`;
        document.getElementById('previewRefund').textContent = `EGP ${p.refundAmount.toFixed(2)}`;

        const alertBox = document.getElementById('previewPolicyAlert');
        const icon = document.getElementById('previewPolicyIcon');
        const headline = document.getElementById('previewPolicyHeadline');
        const message = document.getElementById('previewPolicyMessage');
        const confirmBtn = document.getElementById('btnConfirmCancel');

        if (!p.canCancel) {
            alertBox.className = 'alert alert-danger mb-3 border-0 rounded-3 p-3';
            icon.className = 'bi bi-x-octagon-fill text-danger fs-4 me-2';
            headline.textContent = '@(Loc.IsArabic ? "غير مسموح بالإلغاء" : "Cancellation Not Allowed")';
            message.textContent = p.reasonIfNotAllowed || '@(Loc.IsArabic ? "لا يمكن إلغاء هذا الحجز وفق السياسة المعتمدة." : "This reservation cannot be cancelled.")';
            confirmBtn.disabled = true;
            return;
        }

        confirmBtn.disabled = false;
        if (p.isFreeCancellation) {
            alertBox.className = 'alert alert-success mb-3 border-0 rounded-3 p-3';
            icon.className = 'bi bi-shield-check text-success fs-4 me-2';
            headline.textContent = '@Loc["Bookings.CancelModal.Free"]';
            message.textContent = `@(Loc.IsArabic ? "أنت تلغي الحجز قبل موعد المباراة بـ " : "You are cancelling ")${p.hoursUntilStart} @(Loc.IsArabic ? "ساعة (ضمن فترة الإلغاء المجاني). ستحصل على استرداد 100%." : "hours before match time. Full refund guaranteed.")`;
        } else {
            alertBox.className = 'alert alert-warning mb-3 border-0 rounded-3 p-3';
            icon.className = 'bi bi-exclamation-triangle-fill text-warning fs-4 me-2';
            headline.textContent = `@(Loc.IsArabic ? "تطبق رسوم إلغاء متأخر (" : "Late Cancellation Fee Applies (")${p.lateCancellationFeePercent}%)`;
            message.textContent = `@(Loc.IsArabic ? "أنت تلغي الحجز في وقت متأخر. يطبق رسم إلغاء بقيمة " : "Late cancellation fee applies: ")EGP ${p.cancellationFee.toFixed(2)}.`;
        }
    }
</script>
}
