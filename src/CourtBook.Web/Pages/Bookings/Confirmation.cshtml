@page "{id:guid?}"
@model CourtBook.Web.Pages.Bookings.ConfirmationModel
@{
    ViewData["Title"] = $"{Loc["Confirm.Badge"]} — {Loc["Brand.Name"]}";
    var durationHours = (Model.EndTime - Model.StartTime).TotalHours;
}

<div class="container py-5 text-center position-relative overflow-hidden" id="confetti-container" style="min-height: 80vh;">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            
            <!-- Animated Success Icon -->
            <div class="mb-4 d-flex justify-content-center">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success text-white shadow-lg" style="width: 80px; height: 80px; font-size: 2.75rem;">
                    <i class="bi bi-check-lg"></i>
                </div>
            </div>

            <!-- Header -->
            <h1 class="fw-extrabold text-dark mb-2" style="font-size: 2.25rem; letter-spacing: -0.02em;">
                @Loc["Confirm.Title"]
            </h1>
            <p class="text-muted mb-4 fs-5">
                @Loc["Confirm.Subtitle"]
            </p>

            <!-- Booking Reference Badge -->
            <div class="d-inline-flex align-items-center gap-2 bg-light border px-4 py-2 rounded-pill mb-4 shadow-xs">
                <span class="text-muted small">@Loc["Confirm.RefLabel"]:</span>
                <strong class="text-primary font-monospace fs-6">@Model.BookingReference</strong>
            </div>

            <!-- Booking Details Card -->
            <div class="card border-0 shadow-sm rounded-4 text-start mb-4 overflow-hidden" style="border-radius: var(--ps-radius-xl);">
                <div class="card-body p-4 p-md-5">
                    <h5 class="fw-bold text-dark mb-4 pb-2 border-bottom d-flex align-items-center justify-content-between">
                        <span>@Loc["Book.Step4.Title"]</span>
                        <span class="badge bg-success-subtle text-success small">
                            <i class="bi bi-patch-check-fill me-1"></i> @Loc["BookingStatus.Confirmed"]
                        </span>
                    </h5>

                    <!-- Venue & Court -->
                    <div class="mb-3 d-flex justify-content-between align-items-baseline">
                        <span class="text-muted small">@Loc["Book.Summary.Court"]</span>
                        <div class="text-end">
                            <strong class="text-dark d-block">@Model.VenueName</strong>
                            <span class="text-muted small">@Model.VenueCity</span>
                        </div>
                    </div>

                    <div class="mb-3 d-flex justify-content-between align-items-baseline">
                        <span class="text-muted small">@Loc["Details.Courts.Title"]</span>
                        <div class="text-end">
                            <strong class="text-dark">@Model.CourtName</strong>
                            <span class="badge bg-light text-dark border ms-1" style="font-size: 11px;">@Loc.Sport(Model.SportType)</span>
                        </div>
                    </div>

                    <!-- Date & Time -->
                    <div class="mb-3 d-flex justify-content-between align-items-baseline">
                        <span class="text-muted small">@Loc["Book.Summary.Date"]</span>
                        <strong class="text-dark">@Model.StartTime.ToString(Loc.IsArabic ? "dddd, dd MMMM yyyy" : "dddd, MMMM dd, yyyy")</strong>
                    </div>

                    <div class="mb-3 d-flex justify-content-between align-items-baseline">
                        <span class="text-muted small">@Loc["Book.Summary.Time"]</span>
                        <strong class="text-dark">@Model.StartTime.ToString("hh:mm tt") &mdash; @Model.EndTime.ToString("hh:mm tt")</strong>
                    </div>

                    <div class="mb-3 d-flex justify-content-between align-items-baseline">
                        <span class="text-muted small">@Loc["Book.Summary.Duration"]</span>
                        <strong class="text-dark">@(durationHours >= 1 ? (Loc.IsArabic ? $"{durationHours:0.#} ساعة" : $"{durationHours:0.#} hr") : (Loc.IsArabic ? $"{durationHours * 60:0} دقيقة" : $"{durationHours * 60:0} min"))</strong>
                    </div>

                    <div class="mb-3 d-flex justify-content-between align-items-baseline">
                        <span class="text-muted small">@Loc["Book.Summary.PaymentMethod"]</span>
                        <span class="badge bg-warning-subtle text-warning-emphasis fw-bold">
                            @Loc.PaymentStatus(Model.PaymentStatus)
                        </span>
                    </div>

                    @if (Model.Addons.Any())
                    {
                        <div class="mb-3">
                            <span class="text-muted small d-block mb-1">@Loc["Book.Addons.Title"]</span>
                            <div class="bg-light rounded-3 p-2 small">
                                @foreach (var addon in Model.Addons)
                                {
                                    <div class="d-flex justify-content-between py-1">
                                        <span>@(Loc.IsArabic ? (addon.AddonNameAr ?? addon.AddonName) : addon.AddonName) &times; @addon.Quantity</span>
                                        <span class="fw-semibold">@Loc.FormatCurrency(addon.TotalPrice)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="mb-3 d-flex justify-content-between align-items-baseline text-success">
                            <span class="small fw-semibold">
                                <i class="bi bi-tag-fill me-1"></i>@Loc["Book.Promo.Discount"] @(string.IsNullOrEmpty(Model.PromoCode) ? "" : $"({Model.PromoCode})")
                            </span>
                            <strong class="text-success">- @Loc.FormatCurrency(Model.DiscountAmount)</strong>
                        </div>
                    }

                    <hr class="my-3 text-muted-subtle">

                    <!-- Total Price -->
                    <div class="d-flex justify-content-between align-items-baseline">
                        <span class="text-muted fw-bold">@Loc["Book.Summary.TotalPrice"]</span>
                        <div>
                            @if (decimal.TryParse(Model.TotalPrice, out var parsedPrice))
                            {
                                <span class="fs-2 fw-extrabold text-primary">@Loc.FormatCurrency(parsedPrice)</span>
                            }
                            else
                            {
                                <span class="fs-2 fw-extrabold text-primary">@Model.TotalPrice</span>
                            }
                        </div>
                    </div>

                    <!-- Cancellation Policy Note -->
                    <div class="p-3 bg-light rounded-3 mt-4 text-muted small" style="font-size: 12px; line-height: 1.5;">
                        <i class="bi bi-info-circle text-primary me-1"></i>
                        <strong>@Loc["Details.Policy.Title"]:</strong> @Loc.T("Book.PolicyReminder", 24)
                    </div>
                </div>
            </div>

            <!-- Phase 12: WhatsApp Quick Share CTA -->
            <div class="mb-4">
                <a href="@Model.GetWhatsAppShareUrl(Loc.IsArabic)" target="_blank" rel="noopener noreferrer" class="btn btn-success w-100 py-3 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2 rounded-4" style="background-color: #25D366; border-color: #25D366; font-size: 1.1rem;">
                    <i class="bi bi-whatsapp fs-4"></i>
                    <span>@Loc["Confirm.WhatsApp.Share"]</span>
                </a>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                @if (Model.PaymentStatus != "Completed" && !string.IsNullOrEmpty(Model.BookingId))
                {
                    <a href="/Payments/Pay?bookingId=@Model.BookingId" class="ps-btn ps-btn-primary px-4 py-3 fw-bold">
                        <i class="bi bi-credit-card me-1"></i> @(Loc.IsArabic ? "اختر طريقة الدفع / ادفع الآن" : "Choose Payment Method / Pay Now")
                    </a>
                }
                <a href="/Bookings" class="ps-btn ps-btn-outline px-4 py-3 fw-bold">
                    <i class="bi bi-journal-text me-1"></i> @Loc["Confirm.Btn.MyBookings"]
                </a>
                <a href="/venues" class="ps-btn ps-btn-outline px-4 py-3">
                    <i class="bi bi-compass me-1"></i> @Loc["Confirm.Btn.BrowseMore"]
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 100,
                    spread: 70,
                    origin: { y: 0.6 }
                });
            }
        });
    </script>
}
