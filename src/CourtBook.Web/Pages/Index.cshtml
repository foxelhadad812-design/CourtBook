<!-- How It Works -->
<div class="bg-light py-5 mb-5" id="how-it-works">
    <div class="container py-4">
        <div class="text-center mb-5">
            <h2 class="section-title">How It Works</h2>
            <p class="text-muted">Book your next game in three simple steps.</p>
        </div>
        <div class="row g-5 position-relative">
            <!-- Line connecting steps (desktop only) -->
            <div class="d-none d-md-block position-absolute top-50 start-50 translate-middle w-75" style="height: 2px; background-color: #dee2e6; z-index: 0;"></div>
            
            <div class="col-md-4 text-center position-relative z-index-1 fade-up">
                <div class="bg-white rounded-circle shadow-sm d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px; border: 4px solid var(--primary-color);">
                    <i class="bi bi-search fs-3 text-primary"></i>
                </div>
                <h4 class="fw-bold">1. Find a Court</h4>
                <p class="text-muted">Search by city or sport to find the perfect facility near you.</p>
            </div>
            
            <div class="col-md-4 text-center position-relative z-index-1 fade-up" style="transition-delay: 150ms">
                <div class="bg-white rounded-circle shadow-sm d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px; border: 4px solid var(--accent-color);">
                    <i class="bi bi-calendar-check fs-3 text-accent"></i>
                </div>
                <h4 class="fw-bold">2. Book your Slot</h4>
                <p class="text-muted">Select an available date and time. Confirm your booking instantly.</p>
            </div>
            
            <div class="col-md-4 text-center position-relative z-index-1 fade-up" style="transition-delay: 300ms">
                <div class="bg-white rounded-circle shadow-sm d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px; border: 4px solid var(--primary-color);">
                    <i class="bi bi-trophy fs-3 text-primary"></i>
                </div>
                <h4 class="fw-bold">3. Play & Enjoy</h4>
                <p class="text-muted">Show up with your friends and enjoy the game. No waiting in lines.</p>
            </div>
        </div>
    </div>
</div>

<!-- Popular Venues Section -->
<div class="container mb-5 pb-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <h2 class="section-title mb-0">Popular Venues</h2>
        <a asp-page="/Venues/Index" class="btn btn-outline-primary rounded-pill">View All <i class="bi bi-arrow-right ms-1"></i></a>
    </div>
    
    @if(Model.Venues.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var venue in Model.Venues.Take(6))
            {
                <div class="col fade-up">
                    <div class="card h-100 card-hover border-0 bg-white shadow-sm">
                        @{
                            var firstSport = venue.Courts.FirstOrDefault()?.SportType?.ToLower() ?? "venue";
                            var cardImg = firstSport switch {
                                "football" => "/images/football.jpg",
                                "padel" => "/images/padel.jpg",
                                "tennis" => "/images/tennis.jpg",
                                "basketball" => "/images/basketball.jpg",
                                _ => "/images/venue.jpg"
                            };
                        }
                        <div class="position-relative overflow-hidden" style="height: 180px;">
                            <img src="@cardImg" alt="@venue.Name" class="w-100 h-100 object-fit-cover" style="display: block;">
                            <div class="position-absolute bottom-0 start-0 w-100 p-3" style="background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);">
                                <span class="badge bg-primary rounded-pill mb-1"><i class="bi bi-geo-alt me-1"></i> @venue.City</span>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <h4 class="card-title fw-bold mb-2">@venue.Name</h4>
                            <p class="text-muted small mb-3"><i class="bi bi-pin-map"></i> @venue.Address</p>
                            
                            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-light">
                                <span class="text-secondary fw-medium">
                                    <i class="bi bi-columns-gap text-primary me-1"></i> @venue.Courts.Count Courts
                                </span>
                                <a asp-page="/Venues/Details" asp-route-id="@venue.Id" class="btn btn-primary btn-sm rounded-pill px-3">Book <i class="bi bi-chevron-right ms-1 small"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state bg-white rounded-4 shadow-sm border border-light mt-4">
            <i class="bi bi-shop empty-state-icon text-primary opacity-50"></i>
            <h3 class="fw-bold">No courts available yet</h3>
            <p class="text-muted mb-4">We are expanding fast. Check back soon for new venues!</p>
            <button class="btn btn-outline-primary rounded-pill px-4" disabled>Coming Soon</button>
        </div>
    }
</div>

