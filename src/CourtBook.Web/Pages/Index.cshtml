@page
@model IndexModel
@{
    ViewData["Title"] = $"{Loc["Home.Hero.Title1"]} {Loc["Home.Hero.Title2"]}";
}

<!-- ══════════════════════════════════════════════════════════
     HERO SECTION
     ══════════════════════════════════════════════════════════ -->
<section class="position-relative overflow-hidden py-5 py-lg-7" style="background: var(--ps-hero-gradient, linear-gradient(135deg, #090B0E 0%, #13171F 50%, #090B0E 100%)); color: white;">
    <div style="position: absolute; top: -100px; right: -50px; width: 450px; height: 450px; background: radial-gradient(circle, rgba(16,185,129,0.20) 0%, transparent 70%); border-radius: 50%; pointer-events: none;"></div>
    <div style="position: absolute; bottom: -80px; left: -50px; width: 350px; height: 350px; background: radial-gradient(circle, rgba(245,158,11,0.15) 0%, transparent 70%); border-radius: 50%; pointer-events: none;"></div>

    <div class="container position-relative" style="z-index: 2;">
        <div class="row align-items-center justify-content-center text-center">
            <div class="col-xl-9 col-lg-10">

                <!-- Badge -->
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-4" style="background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.35); color: #6EE7B7; font-size: 0.875rem; font-weight: 600;">
                    <span>@Loc["Home.Hero.Badge"]</span>
                </div>

                <!-- Headline -->
                <h1 class="display-4 fw-extrabold mb-3" style="letter-spacing: -0.03em; line-height: 1.15;">
                    @Loc["Home.Hero.Title1"]<br>
                    <span style="background: linear-gradient(90deg, #34D399 0%, #FBBF24 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                        @Loc["Home.Hero.Title2"]
                    </span>
                </h1>

                <!-- Subtitle -->
                <p class="lead mb-4 mx-auto" style="max-width: 680px; font-size: 1.15rem; color: #94A3B8;">
                    @Loc["Home.Hero.Subtitle"]
                </p>

                @{
                    var homeUser = HttpContext.Session.GetString("UserName");
                    var homeRole = HttpContext.Session.GetString("UserRole");
                }
                @if (!string.IsNullOrEmpty(homeUser))
                {
                    <div class="d-inline-flex flex-wrap align-items-center justify-content-center gap-2 px-4 py-2 rounded-pill mb-4 shadow-sm" style="background: rgba(255, 255, 255, 0.08); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.15);">
                        <span class="fw-bold text-white">
                            @(Loc.IsArabic ? $"أهلاً بك مجدداً، {homeUser}! 👋" : $"Welcome back, {homeUser}! 👋")
                        </span>
                        @if (homeRole == "Owner" || homeRole == "Admin")
                        {
                            <span class="text-white-50 small">@(Loc.IsArabic ? "جاهز لمتابعة منشأتك اليوم؟" : "Ready to manage your venues?")</span>
                            <a href="/Owner" class="badge bg-warning text-dark text-decoration-none px-3 py-1 rounded-pill ms-1 fw-semibold">
                                <i class="bi bi-speedometer2 me-1"></i>@(Loc.IsArabic ? "لوحة المالك" : "Owner Portal")
                            </a>
                        }
                        else
                        {
                            <span class="text-white-50 small">@(Loc.IsArabic ? "جاهز لمباراتك القادمة؟" : "Ready for your next game?")</span>
                            <a href="/bookings" class="badge bg-primary text-white text-decoration-none px-3 py-1 rounded-pill ms-1 fw-semibold">
                                <i class="bi bi-calendar-check me-1"></i>@(Loc.IsArabic ? "حجوزاتي" : "My Bookings")
                            </a>
                            <a href="/games" class="badge bg-success text-white text-decoration-none px-3 py-1 rounded-pill fw-semibold">
                                <i class="bi bi-people me-1"></i>@(Loc.IsArabic ? "المباريات" : "Games")
                            </a>
                        }
                    </div>
                }

                <!-- Search Widget Bar -->
                <div class="card border-0 shadow-2xl p-2 p-md-3 mx-auto text-start" style="background: var(--ps-white); border-radius: var(--ps-radius-2xl); max-width: 850px;">
                    <form action="/venues" method="get" class="row g-2 align-items-center m-0">

                        <!-- Sport Select -->
                        <div class="col-md-4 col-12">
                            <div class="px-3 py-2 rounded-3" style="background: var(--ps-gray-50); border: 1px solid var(--ps-gray-200);">
                                <label class="form-label text-muted text-uppercase fw-bold mb-1" style="font-size: 11px; letter-spacing: 0.05em;">@Loc["Venues.Filter.SportLabel"]</label>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-trophy text-primary fs-5"></i>
                                    <select name="sport" class="form-select border-0 bg-transparent p-0 fw-semibold text-dark shadow-none" style="cursor: pointer;">
                                        <option value="">@Loc["Home.Search.Sport"]</option>
                                        <option value="Football">⚽ @Loc.Sport("Football")</option>
                                        <option value="Padel">🎾 @Loc.Sport("Padel")</option>
                                        <option value="Tennis">🏸 @Loc.Sport("Tennis")</option>
                                        <option value="Basketball">🏀 @Loc.Sport("Basketball")</option>
                                        <option value="Volleyball">🏐 @Loc.Sport("Volleyball")</option>
                                        <option value="Badminton">🏸 @Loc.Sport("Badminton")</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Location Select / Input -->
                        <div class="col-md-5 col-12">
                            <div class="px-3 py-2 rounded-3" style="background: var(--ps-gray-50); border: 1px solid var(--ps-gray-200);">
                                <label class="form-label text-muted text-uppercase fw-bold mb-1" style="font-size: 11px; letter-spacing: 0.05em;">@Loc["Venues.Filter.CityLabel"]</label>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-geo-alt text-primary fs-5"></i>
                                    <select name="city" class="form-select border-0 bg-transparent p-0 fw-semibold text-dark shadow-none" style="cursor: pointer;">
                                        <option value="">@Loc["Home.Search.City"]</option>
                                        <option value="Cairo">@(Loc.IsArabic ? "القاهرة (جميع المناطق)" : "Cairo (All Areas)")</option>
                                        <option value="Maadi">@(Loc.IsArabic ? "المعادي، القاهرة" : "Maadi, Cairo")</option>
                                        <option value="Zamalek">@(Loc.IsArabic ? "الزمالك، القاهرة" : "Zamalek, Cairo")</option>
                                        <option value="Nasr City">@(Loc.IsArabic ? "مدينة نصر، القاهرة" : "Nasr City, Cairo")</option>
                                        <option value="New Cairo">@(Loc.IsArabic ? "القاهرة الجديدة (التجمع الخامس)" : "New Cairo (5th Settlement)")</option>
                                        <option value="6th of October">@(Loc.IsArabic ? "مدينة 6 أكتوبر / الشيخ زايد" : "6th of October City / Zayed")</option>
                                        <option value="الفيوم">@(Loc.IsArabic ? "محافظة الفيوم" : "Fayoum")</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- CTA Submit -->
                        <div class="col-md-3 col-12">
                            <button type="submit" class="ps-btn ps-btn-primary w-100 py-3 d-flex align-items-center justify-content-center gap-2 fw-bold shadow-sm" style="border-radius: var(--ps-radius-xl); font-size: 1rem;">
                                <i class="bi bi-search"></i> @Loc["Home.Search.Button"]
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Trust Stats -->
                <div class="d-flex flex-wrap align-items-center justify-content-center gap-4 gap-md-5 mt-4 small" style="color: #94A3B8;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-primary"></i> @(Loc.IsArabic ? "تأكيد حجز فوري لحظياً" : "Instant Confirmation")
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-warning"></i> @(Loc.IsArabic ? "100% ملاعب معتمدة ومفحوصة" : "100% Verified Venues")
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-clock-history text-success"></i> @(Loc.IsArabic ? "منع تضارب الحجوزات نهائياً" : "Zero Double-Bookings")
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-cash-stack text-info"></i> @(Loc.IsArabic ? "الدفع في المنشأة بأمان" : "Pay at Facility Securely")
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- ══════════════════════════════════════════════════════════
     QUICK SPORT CATEGORIES
     ══════════════════════════════════════════════════════════ -->
<section class="py-5" style="background: var(--ps-white); border-bottom: 1px solid var(--ps-gray-200);">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="fw-bold mb-1" style="letter-spacing: -0.02em;">@Loc["Home.Categories.Title"]</h3>
                <p class="text-muted small mb-0">@Loc["Home.Categories.Subtitle"]</p>
            </div>
            <a href="/venues" class="ps-btn ps-btn-ghost ps-btn-sm d-none d-sm-flex align-items-center gap-1">
                @Loc["Home.Featured.ViewAll"] <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row g-3 g-md-4">
            @{
                var sportsList = new[] {
                    new { Key = "Football", Icon = "bi-record-circle-fill", Color = "var(--ps-football, #10B981)" },
                    new { Key = "Padel", Icon = "bi-bullseye", Color = "var(--ps-padel, #06B6D4)" },
                    new { Key = "Tennis", Icon = "bi-circle-fill", Color = "var(--ps-tennis, #EAB308)" },
                    new { Key = "Basketball", Icon = "bi-dribbble", Color = "var(--ps-basketball, #F97316)" },
                    new { Key = "Volleyball", Icon = "bi-trophy-fill", Color = "var(--ps-volleyball, #8B5CF6)" },
                    new { Key = "Badminton", Icon = "bi-activity", Color = "var(--ps-badminton, #EC4899)" }
                };
            }

            @foreach (var s in sportsList)
            {
                <div class="col-6 col-md-4 col-lg-2">
                    <a href="/venues?sport=@s.Key" class="text-decoration-none">
                        <div class="card h-100 border-0 text-center p-3 transition-all ps-category-card" style="background: var(--ps-gray-50); border: 1px solid var(--ps-gray-200); border-radius: var(--ps-radius-xl); transition: all 0.2s ease;">
                            <div class="mx-auto mb-2 d-flex align-items-center justify-content-center rounded-circle shadow-sm" style="width: 48px; height: 48px; background: var(--ps-white); color: @s.Color;">
                                <i class="bi @s.Icon fs-4"></i>
                            </div>
                            <span class="fw-bold d-block mb-0" style="font-size: 0.95rem; color: var(--ps-gray-900);">@Loc.Sport(s.Key)</span>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- ══════════════════════════════════════════════════════════
     FEATURED FACILITIES (Real-Time from API)
     ══════════════════════════════════════════════════════════ -->
<section class="py-6" style="background: var(--ps-gray-50);">
    <div class="container">
        <div class="d-flex flex-column flex-sm-row align-items-sm-end justify-content-between mb-5 gap-2">
            <div>
                <span class="badge px-3 py-1 rounded-pill mb-2" style="background: var(--ps-primary-50); color: var(--ps-primary); font-weight: 600; font-size: 12px;">@Loc["Venues.Card.Verified"]</span>
                <h2 class="fw-extrabold mb-1" style="letter-spacing: -0.02em;">@Loc["Home.Featured.Title"]</h2>
                <p class="text-muted mb-0">@Loc["Home.Featured.Subtitle"]</p>
            </div>
            <a href="/venues" class="ps-btn ps-btn-secondary">
                @Loc["Home.Featured.ViewAll"] <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        @if (Model.FeaturedVenues.Any())
        {
            <div class="row g-4">
                @foreach (var venue in Model.FeaturedVenues)
                {
                    var firstSport = venue.Sports.FirstOrDefault()?.ToLower() ?? "football";
                    var sportImage = !string.IsNullOrEmpty(venue.PrimaryImageUrl)
                        ? venue.PrimaryImageUrl
                        : firstSport switch {
                            "football" => "/images/venues/football/football-pitch-01.jpg",
                            "padel" => "/images/venues/padel/padel-court-01.jpg",
                            "tennis" => "/images/venues/tennis/tennis-clay-01.jpg",
                            "basketball" => "/images/venues/basketball/basketball-indoor-01.jpg",
                            "volleyball" => "/images/venues/volleyball/volleyball-indoor-01.jpg",
                            "badminton" => "/images/venues/badminton/badminton-court-01.jpg",
                            _ => "/images/venues/facilities/complex-exterior-01.jpg"
                        };
                    var fallbackImage = $"/images/venues/fallbacks/{firstSport}.jpg";

                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border shadow-sm ps-venue-card overflow-hidden" style="border-radius: var(--ps-radius-xl); border-color: var(--ps-gray-200) !important;">

                            <!-- 16:9 Image Showcase -->
                            <div class="ps-venue-card-img-wrapper">
                                <img src="@sportImage"
                                     data-fallback="@fallbackImage"
                                     alt="@venue.Name - Sports Arena"
                                     class="ps-venue-card-img"
                                     onerror="this.onerror=null;this.src='@fallbackImage';">

                                <!-- Verified Badge Overlay -->
                                @if (venue.IsVerified)
                                {
                                    <div class="ps-venue-badge-overlay">
                                        <span class="badge bg-white text-dark shadow-sm px-2 py-1 rounded-pill d-flex align-items-center gap-1" style="font-size: 11px; font-weight: 600;">
                                            <i class="bi bi-patch-check-fill text-primary"></i> @Loc["Venues.Card.Verified"]
                                        </span>
                                    </div>
                                }

                                <!-- Rating pill -->
                                <div class="position-absolute top-0 end-0 m-3" style="z-index: 2;">
                                    <span class="badge text-white px-2 py-1 rounded-pill d-flex align-items-center gap-1 shadow-sm" style="font-size: 12px; font-weight: 700; background: rgba(15,23,42,0.85); backdrop-filter: blur(4px);">
                                        <i class="bi bi-star-fill text-warning"></i> @venue.AverageRating.ToString("0.0")
                                        <span class="text-white-50 fw-normal" style="font-size: 10px;">(@venue.TotalReviews)</span>
                                    </span>
                                </div>

                                <!-- Starting Price Overlay -->
                                <div class="ps-venue-price-overlay">
                                    @Loc.FormatCurrency(venue.StartingPrice) @Loc["Venues.Card.PerHour"]
                                </div>
                            </div>

                            <!-- Body -->
                            <div class="card-body p-4 d-flex flex-column">
                                <div class="d-flex align-items-center gap-1 text-muted small mb-2">
                                    <i class="bi bi-geo-alt-fill text-primary"></i>
                                    <span>@venue.City @(!string.IsNullOrEmpty(venue.Area) ? $"• {venue.Area}" : "")</span>
                                </div>

                                <h5 class="fw-bold mb-2 text-truncate" style="color: var(--ps-gray-900);">@venue.Name</h5>
                                <p class="text-muted small mb-3 text-truncate-2" style="font-size: 13px; line-height: 1.5;">
                                    @venue.Description
                                </p>

                                <!-- Sport tags -->
                                <div class="d-flex flex-wrap gap-1 mb-4">
                                    @foreach (var sp in venue.Sports)
                                    {
                                        <span class="badge px-2 py-1 rounded-pill" style="background: var(--ps-primary-50); color: var(--ps-primary); font-size: 11px; font-weight: 600;">
                                            @Loc.Sport(sp)
                                        </span>
                                    }
                                </div>

                                <!-- Footer details & action -->
                                <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between">
                                    <div>
                                        <span class="text-muted small d-block">@Loc["Venues.Card.StartingFrom"]</span>
                                        <div class="d-flex align-items-baseline gap-1">
                                            <span class="fw-extrabold fs-5" style="color: var(--ps-gray-900);">@Loc.FormatCurrency(venue.StartingPrice)</span>
                                        </div>
                                    </div>
                                    <a href="/venues/details?id=@venue.Id" class="ps-btn ps-btn-primary ps-btn-sm px-3">
                                        @Loc["Venues.Card.ViewFacility"] <i class="bi bi-chevron-right ms-1 small"></i>
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="ps-empty-state bg-white shadow-sm p-5 text-center" style="border-radius: var(--ps-radius-xl);">
                <i class="bi bi-building ps-empty-icon text-muted mb-3" style="font-size: 3rem;"></i>
                <h4 class="fw-bold">@Loc["Venues.Empty.Title"]</h4>
                <p class="text-muted mb-4">@Loc["Venues.Empty.Message"]</p>
                <a href="/venues" class="ps-btn ps-btn-primary">@Loc["Home.Featured.ViewAll"]</a>
            </div>
        }
    </div>
</section>

<!-- ══════════════════════════════════════════════════════════
     COMMUNITY GAMES SHOWCASE
     ══════════════════════════════════════════════════════════ -->
@if (Model.UpcomingGames.Any())
{
    <section class="py-6" style="background: var(--ps-white); border-top: 1px solid var(--ps-gray-200);">
        <div class="container">
            <div class="d-flex flex-column flex-sm-row align-items-sm-end justify-content-between mb-4 gap-2">
                <div>
                    <span class="badge px-3 py-1 rounded-pill mb-2" style="background: var(--ps-accent-50); color: var(--ps-accent); font-weight: 600; font-size: 12px;">
                        <i class="bi bi-people-fill me-1"></i>@(Loc.IsArabic ? "مباريات مجتمعية مفتوحة" : "Open Community Games")
                    </span>
                    <h2 class="fw-extrabold mb-1" style="letter-spacing: -0.02em;">@(Loc.IsArabic ? "انضم لمباراة اليوم ولا تبحث عن فريق" : "Join a Game Today — No Team Needed")</h2>
                    <p class="text-muted mb-0">@(Loc.IsArabic ? "مباريات تناسب فئتك العمرية ومستواك في مختلف المنشآت والملاعب." : "Matches tailored to your age group and skill level across top sports facilities.")</p>
                </div>
                <a href="/games" class="ps-btn ps-btn-secondary">
                    @(Loc.IsArabic ? "استعراض كل المباريات" : "Explore All Games") <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>

            <div class="row g-4">
                @foreach (var game in Model.UpcomingGames)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border shadow-sm p-4 d-flex flex-column" style="border-radius: var(--ps-radius-xl); border-color: var(--ps-gray-200) !important; background: var(--ps-white);">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 rounded-pill">
                                    @Loc.Sport(game.SportType)
                                </span>
                                <span class="badge bg-light text-dark border px-2 py-1 rounded-pill small">
                                    <i class="bi bi-shield-check text-success me-1"></i>@game.AgeDisplay
                                </span>
                            </div>

                            <h5 class="fw-bold mb-1 text-dark">@game.Title</h5>
                            <div class="text-muted small mb-3">
                                <i class="bi bi-geo-alt me-1 text-primary"></i>@game.VenueName &bull; @game.CourtName
                            </div>

                            <div class="d-flex align-items-center gap-3 text-muted small mb-3">
                                <div><i class="bi bi-calendar-event me-1 text-primary"></i>@game.Date.ToString("MMM dd, yyyy")</div>
                                <div><i class="bi bi-clock me-1 text-primary"></i>@game.StartTime</div>
                            </div>

                            <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="text-muted small d-block">@(Loc.IsArabic ? "المقاعد" : "Spots")</span>
                                    <span class="fw-bold text-dark">@game.CurrentPlayersCount / @game.MaxPlayers</span>
                                </div>
                                <a href="/games" class="ps-btn ps-btn-primary ps-btn-sm rounded-pill px-3">
                                    @(Loc.IsArabic ? "تفاصيل المباراة" : "View Game")
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- ══════════════════════════════════════════════════════════
     FOR FACILITY OWNERS CTA
     ══════════════════════════════════════════════════════════ -->
<section class="py-6" style="background: var(--ps-cta-gradient, linear-gradient(135deg, #065F46 0%, #059669 100%)); color: white;">
    <div class="container">
        <div class="row align-items-center justify-content-between g-4">
            <div class="col-lg-7">
                <span class="badge bg-white text-primary px-3 py-1 rounded-pill mb-3 fw-bold">@Loc["Home.OwnerCta.Title"]</span>
                <h2 class="display-6 fw-extrabold mb-3">@Loc["Home.OwnerCta.Subtitle"]</h2>
                <p class="text-white-50 lead mb-0" style="font-size: 1.1rem;">
                    @(Loc.IsArabic ? "تخلص من فوضى الاتصالات الهاتفية، امنع تضارب الحجوزات، وأتح للاعبين حجز ملاعبك على مدار 24 ساعة." : "Eliminate phone scheduling chaos, prevent double-bookings, automate player reminders, and access real-time revenue analytics.")
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a href="/register" class="ps-btn ps-btn-secondary ps-btn-lg fw-bold px-4 py-3 shadow-lg" style="background: white; color: var(--ps-primary);">
                    @Loc["Home.OwnerCta.Button"] <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>
</section>
