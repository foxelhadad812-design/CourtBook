@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<div class="position-relative py-5 mb-5" style="background: linear-gradient(135deg, rgba(26,122,74,0.9) 0%, rgba(13,74,43,0.9) 100%), url('/images/venue.jpg') center/cover no-repeat; min-height: 450px; display: flex; align-items: center;">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background-image: radial-gradient(rgba(255,255,255,0.15) 2px, transparent 2px); background-size: 30px 30px; opacity: 0.2;"></div>
    
    <div class="container position-relative z-index-1">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8 col-md-10 py-5">
                <span class="badge bg-accent text-white px-3 py-2 rounded-pill mb-3 shadow-sm">Trusted by 10,000+ players</span>
                <h1 class="display-3 fw-bolder text-white mb-3" style="letter-spacing: -1px;">Find & Book Your Perfect Court</h1>
                <p class="lead text-white-50 mb-5 fs-4">Join thousands of players enjoying football, padel, and tennis in seconds.</p>
                
                <div class="bg-white p-2 rounded-pill shadow-lg d-flex align-items-center mx-auto" style="max-width: 600px;">
                    <i class="bi bi-geo-alt-fill text-muted ms-3 fs-5"></i>
                    <form method="get" class="d-flex w-100 m-0 p-0 align-items-center">
                        <input asp-for="SearchCity" class="form-control border-0 shadow-none fs-5 py-2 px-3" placeholder="Where do you want to play?" style="background: transparent;" />
                        <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fs-5 fw-bold d-flex align-items-center">
                            Search
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Stats Bar -->
<div class="container mb-5 pb-4">
    <div class="row g-4 text-center">
        <div class="col-md-4 fade-up">
            <div class="p-4 bg-white rounded-4 shadow-sm border border-light h-100 card-hover">
                <div class="d-inline-flex align-items-center justify-content-center bg-light text-primary rounded-circle mb-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-grid-fill fs-3"></i>
                </div>
                <h2 class="fw-bold mb-0">150+</h2>
                <p class="text-muted mb-0">Active Courts</p>
            </div>
        </div>
        <div class="col-md-4 fade-up" style="transition-delay: 100ms">
            <div class="p-4 bg-white rounded-4 shadow-sm border border-light h-100 card-hover">
                <div class="d-inline-flex align-items-center justify-content-center bg-light text-accent rounded-circle mb-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-map-fill fs-3"></i>
                </div>
                <h2 class="fw-bold mb-0">20+</h2>
                <p class="text-muted mb-0">Cities Covered</p>
            </div>
        </div>
        <div class="col-md-4 fade-up" style="transition-delay: 200ms">
            <div class="p-4 bg-white rounded-4 shadow-sm border border-light h-100 card-hover">
                <div class="d-inline-flex align-items-center justify-content-center bg-light text-success rounded-circle mb-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-emoji-smile-fill fs-3"></i>
                </div>
                <h2 class="fw-bold mb-0">10k+</h2>
                <p class="text-muted mb-0">Happy Players</p>
            </div>
        </div>
    </div>
</div>

<!-- Popular Sports -->
<div class="container mb-5 pb-5">
    <div class="text-center mb-5">
        <h2 class="section-title">Popular Sports</h2>
    </div>
    <div class="row g-4 text-center">
        <div class="col-6 col-md-3 fade-up">
            <a asp-page="/Venues/Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm card-hover py-4 rounded-4">
                    <i class="bi bi-record-circle-fill text-success fs-1 mb-2"></i>
                    <h5 class="fw-bold text-dark mb-0">Football</h5>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3 fade-up" style="transition-delay: 100ms">
            <a asp-page="/Venues/Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm card-hover py-4 rounded-4">
                    <i class="bi bi-bullseye text-primary fs-1 mb-2"></i>
                    <h5 class="fw-bold text-dark mb-0">Padel</h5>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3 fade-up" style="transition-delay: 200ms">
            <a asp-page="/Venues/Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm card-hover py-4 rounded-4">
                    <i class="bi bi-circle-fill text-warning fs-1 mb-2"></i>
                    <h5 class="fw-bold text-dark mb-0">Tennis</h5>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3 fade-up" style="transition-delay: 300ms">
            <a asp-page="/Venues/Index" class="text-decoration-none">
