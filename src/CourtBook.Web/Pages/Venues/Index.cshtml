@page
@model CourtBook.Web.Pages.Venues.IndexModel
@{
    ViewData["Title"] = "All Venues";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h2 class="section-title mb-0">Discover Venues</h2>
        <span class="text-muted fw-medium">@Model.Venues.Count venues found</span>
    </div>

    @if (Model.Venues.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var venue in Model.Venues)
            {
                <div class="col">
                    <div class="card h-100 card-hover border-0 bg-white">
                        <div class="position-relative overflow-hidden" style="height: 180px;">
                            @Html.Raw(CourtBook.Web.Helpers.SportIllustrations.GetVenueHeroSvg())
                            <div class="position-absolute bottom-0 start-0 w-100 p-3" style="background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);">
                                <span class="badge bg-primary rounded-pill mb-1"><i class="bi bi-geo-alt me-1"></i> @venue.City</span>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <h4 class="card-title fw-bold mb-2">@venue.Name</h4>
                            <p class="text-muted small mb-3"><i class="bi bi-pin-map"></i> @venue.Address</p>
                            
                            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-light">
                                <span class="text-secondary fw-medium">
                                    <i class="bi bi-columns-gap text-primary me-1"></i> @venue.Courts.Count Courts
                                </span>
                                <a asp-page="/Venues/Details" asp-route-id="@venue.Id" class="btn btn-primary btn-sm rounded-pill px-3">View Courts</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-search empty-state-icon"></i>
            <h3 class="fw-bold">No courts found</h3>
            <p class="text-muted mb-4">We couldn't find any courts matching your criteria.</p>
            <a asp-page="/Index" class="btn btn-primary rounded-pill px-4">Search Again</a>
        </div>
    }
</div>
