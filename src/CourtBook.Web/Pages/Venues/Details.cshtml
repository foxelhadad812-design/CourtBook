@page "{id:guid}"
@model CourtBook.Web.Pages.Venues.DetailsModel
@{
    ViewData["Title"] = Model.Venue?.Name ?? "Venue Details";
}

@if (Model.Venue != null)
{
    <div class="container py-4">
        <!-- Venue Header -->
        <div class="card border-0 shadow-sm mb-5 overflow-hidden">
            <div class="position-relative" style="height: 250px;">
                <img src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=1200&q=80" alt="@Model.Venue.Name" class="w-100 h-100 object-fit-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='block'">
                <div class="fallback-img w-100 h-100" style="background: linear-gradient(135deg, var(--primary-color), #0d4a2b); display: none !important;"></div>
                <div class="position-absolute top-0 start-0 w-100 h-100" style="background: rgba(0,0,0,0.3);"></div>
            </div>
            <div class="card-body p-4 position-relative">
                <div class="bg-white rounded-circle shadow d-flex justify-content-center align-items-center position-absolute" 
                     style="width: 80px; height: 80px; top: -40px; border: 4px solid white;">
                    <i class="bi bi-building fs-1 text-primary"></i>
                </div>
                <div class="pt-4 mt-2">
                    <h1 class="fw-bold mb-1">@Model.Venue.Name</h1>
                    <p class="text-muted fs-5 mb-0"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Venue.City &mdash; @Model.Venue.Address</p>
                </div>
            </div>
        </div>

        <h3 class="section-title mb-4">Available Courts</h3>
        
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var court in Model.Venue.Courts)
            {
                var badgeClass = court.SportType.ToLower() switch
                {
                    "football" => "badge-football",
                    "padel" => "badge-padel",
                    "tennis" => "badge-tennis",
                    _ => "bg-secondary"
                };

                var courtImg = court.SportType.ToLower() switch
                {
                    "football" => "https://images.unsplash.com/photo-1556056504-5c7696c4c28d?w=800&q=80",
                    "padel" => "https://images.unsplash.com/photo-1554068865-24cecd4e34b8?w=800&q=80",
                    "tennis" => "https://images.unsplash.com/photo-1542144582-1ba00456b5e3?w=800&q=80",
                    _ => "https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=800&q=80"
                };

                <div class="col">
                    <div class="card h-100 card-hover border-0 overflow-hidden">
                        <div class="position-relative" style="height: 160px;">
                            <img src="@courtImg" alt="@court.Name" class="w-100 h-100 object-fit-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'">
                            <div class="fallback-img w-100 h-100 bg-secondary d-flex align-items-center justify-content-center" style="display: none !important;">
                                <i class="bi bi-circle fs-1 text-white opacity-50"></i>
                            </div>
                            <div class="position-absolute top-0 end-0 p-3">
                                <span class="badge @badgeClass rounded-pill px-3 py-2 shadow-sm">@court.SportType</span>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <h5 class="card-title fw-bold text-dark mb-3">@court.Name</h5>
                            
                            <div class="mb-3">
                                <span class="fs-3 fw-bolder text-dark">$@court.PricePerHour</span>
                                <span class="text-muted">/ hr</span>
                            </div>
                            
                            <div class="d-flex align-items-center mb-4">
                                <div class="rounded-circle @(court.IsActive ? "bg-success" : "bg-danger") me-2" style="width: 10px; height: 10px;"></div>
                                <span class="text-muted small fw-medium">@(court.IsActive ? "Available for booking" : "Currently Unavailable")</span>
                            </div>
                            
                            @if (court.IsActive)
                            {
                                <a asp-page="/Courts/Book" asp-route-venueId="@Model.Venue.Id" asp-route-id="@court.Id" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">
                                    Book This Court
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-light w-100 py-2 fw-bold text-muted" disabled>Unavailable</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
