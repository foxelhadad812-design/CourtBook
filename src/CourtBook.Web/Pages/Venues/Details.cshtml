@page "{id:guid}"
@model CourtBook.Web.Pages.Venues.DetailsModel
@{
    ViewData["Title"] = Model.Venue?.Name;
}

@if (Model.Venue != null)
{
    <div class="mb-4">
        <h2>@Model.Venue.Name</h2>
        <p class="text-muted fs-5">@Model.Venue.City - @Model.Venue.Address</p>
    </div>

    <h4>Available Courts</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4 mt-2">
        @foreach (var court in Model.Venue.Courts)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 bg-light">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@court.Name</h5>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="badge bg-secondary">@court.SportType</span>
                            <span class="fw-bold text-success">$@court.PricePerHour / hr</span>
                        </div>
                        <p class="card-text mb-1"><strong>Status:</strong> @(court.IsActive ? "Active" : "Inactive")</p>
                    </div>
                    <div class="card-footer bg-transparent border-top-0">
                        @if (court.IsActive)
                        {
                            <a asp-page="/Courts/Book" asp-route-venueId="@Model.Venue.Id" asp-route-id="@court.Id" class="btn btn-primary w-100">Book Now</a>
                        }
                        else
                        {
                            <button class="btn btn-secondary w-100" disabled>Unavailable</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
