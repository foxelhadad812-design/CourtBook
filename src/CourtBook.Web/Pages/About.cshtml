@page
@{
    ViewData["Title"] = "About Us";
}

<!-- Hero Section -->
<div class="position-relative py-5 mb-5 text-center text-white" style="background: linear-gradient(135deg, var(--primary-color) 0%, #0d4a2b 100%);">
    <div class="container py-5">
        <h1 class="display-4 fw-bolder mb-3">About CourtBook</h1>
        <p class="lead text-white-50 mx-auto" style="max-width: 700px;">
            We believe finding and booking a sports court should be as easy as ordering food online.
        </p>
    </div>
</div>

<div class="container mb-5">
    <!-- How it works -->
    <div class="text-center mb-5">
        <h2 class="section-title">How It Works</h2>
    </div>
    <div class="row g-4 text-center mb-5 pb-4 border-bottom">
        <div class="col-md-4">
            <div class="p-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-light text-primary rounded-circle mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-search fs-1"></i>
                </div>
                <h4 class="fw-bold">1. Search</h4>
                <p class="text-muted">Find the perfect court near you based on sport, city, and availability.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-light text-accent rounded-circle mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-calendar2-check fs-1"></i>
                </div>
                <h4 class="fw-bold">2. Book</h4>
                <p class="text-muted">Choose your time slot and confirm your booking instantly with zero hassle.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-light text-success rounded-circle mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-trophy fs-1"></i>
                </div>
                <h4 class="fw-bold">3. Play</h4>
                <p class="text-muted">Show up at the venue with your friends and enjoy the game.</p>
            </div>
        </div>
    </div>

    <!-- Stats -->
    <div class="row text-center mb-5 pb-5">
        <div class="col-md-4 mb-4">
            <h1 class="display-4 fw-bolder text-primary mb-0">500+</h1>
            <p class="fs-5 text-muted">Courts</p>
        </div>
        <div class="col-md-4 mb-4">
            <h1 class="display-4 fw-bolder text-primary mb-0">20+</h1>
            <p class="fs-5 text-muted">Cities</p>
        </div>
        <div class="col-md-4 mb-4">
            <h1 class="display-4 fw-bolder text-primary mb-0">10k+</h1>
            <p class="fs-5 text-muted">Happy Players</p>
        </div>
    </div>

    <!-- Team -->
    <div class="text-center mb-5">
        <h2 class="section-title">Our Team</h2>
    </div>
    <div class="row g-4 justify-content-center">
        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm text-center p-4">
                <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 100px; height: 100px; font-size: 2.5rem; font-weight: bold;">
                    AM
                </div>
                <h5 class="fw-bold mb-1">Ahmed Mahmoud</h5>
                <p class="text-muted small">Founder & CEO</p>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm text-center p-4">
                <div class="rounded-circle bg-accent text-white d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 100px; height: 100px; font-size: 2.5rem; font-weight: bold;">
                    SO
                </div>
                <h5 class="fw-bold mb-1">Sara Omar</h5>
                <p class="text-muted small">Head of Operations</p>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm text-center p-4">
                <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 100px; height: 100px; font-size: 2.5rem; font-weight: bold;">
                    KH
                </div>
                <h5 class="fw-bold mb-1">Kareem Hassan</h5>
                <p class="text-muted small">CTO</p>
            </div>
        </div>
    </div>
</div>
