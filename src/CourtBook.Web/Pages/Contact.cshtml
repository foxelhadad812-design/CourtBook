@page
@{
    ViewData["Title"] = "Contact Us";
}

<!-- Hero Section -->
<div class="position-relative py-5 mb-5 text-center text-white" style="background: linear-gradient(135deg, var(--primary-color) 0%, #0d4a2b 100%);">
    <div class="container py-4">
        <h1 class="display-4 fw-bolder mb-3">Get in Touch</h1>
        <p class="lead text-white-50 mx-auto" style="max-width: 600px;">
            Have a question, feedback, or need support? We'd love to hear from you.
        </p>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-5">
        <!-- Contact Info & Map -->
        <div class="col-lg-5">
            <h3 class="fw-bold mb-4">Contact Information</h3>
            
            <div class="d-flex align-items-center mb-4">
                <div class="bg-light text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                    <i class="bi bi-geo-alt fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Our Headquarters</h6>
                    <p class="text-muted mb-0">123 Sports Avenue, Downtown Cairo, Egypt</p>
                </div>
            </div>
            
            <div class="d-flex align-items-center mb-4">
                <div class="bg-light text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                    <i class="bi bi-envelope fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Email Us</h6>
                    <p class="text-muted mb-0">support@courtbook.dev</p>
                </div>
            </div>
            
            <div class="d-flex align-items-center mb-4">
                <div class="bg-light text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                    <i class="bi bi-telephone fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Call Us</h6>
                    <p class="text-muted mb-0">+20 12 3456 7890 (Mon-Fri, 9am-6pm)</p>
                </div>
            </div>

            <!-- Map Placeholder -->
            <div class="card border-0 bg-light rounded-4 overflow-hidden mt-4 shadow-sm" style="height: 250px;">
                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                    <i class="bi bi-pin-map-fill fs-1 text-danger mb-2"></i>
                    <h5 class="fw-bold text-dark">Cairo, Egypt</h5>
                    <small>Map View Placeholder</small>
                </div>
            </div>
        </div>

        <!-- Contact Form -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm p-4 p-md-5">
                <h3 class="fw-bold mb-4">Send us a Message</h3>
                
                <div id="contactSuccess" class="alert alert-success border-0 shadow-sm d-none align-items-center mb-4">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    <div>Thank you for reaching out! We've received your message and will get back to you shortly.</div>
                </div>

                <form id="contactForm">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Your Name</label>
                            <input type="text" class="form-control" required placeholder="John Doe">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Email Address</label>
                            <input type="email" class="form-control" required placeholder="name@example.com">
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-medium">Subject</label>
                        <select class="form-select" required>
                            <option value="">Select a topic...</option>
                            <option value="support">General Support</option>
                            <option value="billing">Billing Issue</option>
                            <option value="partnership">Partner with us (Venue Owner)</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label fw-medium">Message</label>
                        <textarea class="form-control" rows="5" required placeholder="How can we help you?"></textarea>
                    </div>
                    
                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm" id="contactBtn">
                        Send Message
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('contactForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            var btn = document.getElementById('contactBtn');
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Sending...';
            btn.classList.add('disabled');
            
            setTimeout(function() {
                document.getElementById('contactForm').reset();
                document.getElementById('contactSuccess').classList.remove('d-none');
                document.getElementById('contactSuccess').classList.add('d-flex');
                
                btn.innerHTML = 'Send Message';
                btn.classList.remove('disabled');
                
                // Also show a toast
                if(typeof toastr !== 'undefined') {
                    toastr.success('Message sent successfully!');
                }
            }, 1000);
        });
    </script>
}
