@page
@model CourtBook.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center my-5">
    <div class="empty-state">
        <i class="bi bi-exclamation-octagon text-danger" style="font-size: 5rem;"></i>
        <h2 class="fw-bold mb-3 mt-4">Something went wrong on our end.</h2>
        <p class="lead text-muted mb-5">We're experiencing some technical difficulties. Please try again later.</p>
        <div class="d-flex justify-content-center gap-3">
            <a href="javascript:location.reload()" class="btn btn-outline-primary btn-lg rounded-pill px-4">Try Again</a>
            <a asp-page="/Index" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm">Go Home</a>
        </div>
    </div>
</div>
