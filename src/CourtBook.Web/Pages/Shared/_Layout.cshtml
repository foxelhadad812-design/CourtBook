<!DOCTYPE html>
<html lang="@Loc.Lang" dir="@Loc.Direction" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@Loc["Brand.Tagline"]" />
    <title>@ViewData["Title"] — @Loc["Brand.Name"]</title>

    <!-- Instant Theme Detection to prevent FOUT -->
    <script>
        (function() {
            var saved = localStorage.getItem('playspot-theme');
            var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            var theme = saved || (prefersDark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>

    <!-- Google Fonts: Inter & Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5 CSS (Dynamic LTR / RTL from local wwwroot/lib) -->
    @if (Loc.IsArabic)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" asp-append-version="true" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    }

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- PlaySpot Design System -->
    <link rel="stylesheet" href="~/css/playspot.css" asp-append-version="true" />

    <!-- Page-specific styles -->
    @await RenderSectionAsync("Styles", required: false)

    <style>
        /* Ensure body fills viewport and footer stays at bottom */
        body { min-height: 100vh; display: flex; flex-direction: column; }
        main { flex: 1; }
    </style>
</head>
<body>

<!-- ══════════════════════════════════════════════════════════
     NAVIGATION BAR
     ══════════════════════════════════════════════════════════ -->
<nav class="ps-navbar" role="navigation" aria-label="Main navigation">
    <div class="container-fluid px-4">

        <!-- Brand -->
        <a class="ps-navbar-brand" href="/" aria-label="PlaySpot Home">
            <div class="brand-icon" aria-hidden="true">⚡</div>
            <span>@Loc["Brand.Name"]</span>
        </a>

        <!-- Desktop Nav Links -->
        <div class="ps-nav-links d-none d-lg-flex">
            <a class="ps-nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Equals("/Index", StringComparison.OrdinalIgnoreCase) == true ? "active" : "")"
               href="/">
                <i class="bi bi-house-door"></i> @Loc["Nav.Home"]
            </a>
            <a class="ps-nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Venues", StringComparison.OrdinalIgnoreCase) == true ? "active" : "")"
               href="/venues">
                <i class="bi bi-building"></i> @Loc["Nav.Venues"]
            </a>
            <a class="ps-nav-link" href="/venues">
                <i class="bi bi-trophy"></i> @Loc["Nav.Sports"]
            </a>
            <a class="ps-nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Games", StringComparison.OrdinalIgnoreCase) == true ? "active" : "")"
               href="/games">
                <i class="bi bi-people"></i> @Loc["Nav.Games"]
            </a>
        </div>

        <!-- Actions -->
        <div class="ps-navbar-actions d-flex align-items-center gap-2">
            <!-- Theme toggle button -->
            <button id="ps-theme-toggle" class="ps-btn ps-btn-ghost ps-btn-sm" type="button" aria-label="@Loc["Theme.Toggle"]" title="@Loc["Theme.Toggle"]">
                <i class="bi bi-moon-stars-fill text-primary"></i>
            </button>

            <!-- Language switcher -->
            <a href="/SetLanguage?culture=@(Loc.IsArabic ? "en" : "ar")&returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)"
               class="ps-btn ps-btn-ghost ps-btn-sm d-flex align-items-center gap-1 fw-bold"
               title="@(Loc.IsArabic ? "Switch to English" : "التحويل للغة العربية")">
                <i class="bi bi-translate text-primary"></i>
                <span>@Loc["Lang.Switch"]</span>
            </a>

            @{
                var userName  = Context.Session.GetString("UserName");
                var userRole  = Context.Session.GetString("UserRole");
                var loggedIn  = !string.IsNullOrEmpty(userName);
            }

            @if (loggedIn)
            {
                <!-- Notification Bell Dropdown -->
                <div class="dropdown me-1" id="ps-notifications-container">
                    <button class="ps-btn ps-btn-ghost ps-btn-sm position-relative d-flex align-items-center justify-content-center"
                            type="button" id="ps-notifications-btn" data-bs-toggle="dropdown" aria-expanded="false"
                            title="@Loc["Nav.Notifications"]" style="width: 38px; height: 38px; border-radius: 50%;">
                        <i class="bi bi-bell-fill fs-5 text-primary"></i>
                        <span id="ps-notifications-badge"
                              class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none"
                              style="font-size: 0.65rem; padding: 0.25em 0.5em;">
                            0
                        </span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-0"
                        style="border-radius: var(--ps-radius-lg); width: 340px; max-height: 440px; overflow-y: auto;"
                        aria-labelledby="ps-notifications-btn">
                        <li class="p-3 border-bottom d-flex justify-content-between align-items-center bg-body-tertiary">
                            <span class="fw-bold small" style="color: var(--ps-text);">@Loc["Nav.Notifications"]</span>
                            <a href="/notifications" class="small text-decoration-none fw-semibold" style="color: var(--ps-primary);">
                                @(Loc.IsArabic ? "عرض الكل" : "View All")
                            </a>
                        </li>
                        <li>
                            <div id="ps-notifications-preview-list">
                                <div class="p-3 text-center text-muted small">
                                    <div class="spinner-border spinner-border-sm text-primary me-1" role="status"></div>
                                    @(Loc.IsArabic ? "جاري تحميل الإشعارات..." : "Loading notifications...")
                                </div>
                            </div>
                        </li>
                        <li class="p-2 text-center border-top bg-body-tertiary">
                            <a href="/notifications" class="small fw-semibold text-decoration-none" style="color: var(--ps-text);">
                                @(Loc.IsArabic ? "مركز الإشعارات الكامل" : "Notification Center") <i class="bi bi-arrow-right"></i>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- User dropdown -->
                <div class="dropdown">
                    <button class="ps-btn ps-btn-secondary ps-btn-sm dropdown-toggle d-flex align-items-center gap-2"
                            type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div style="width:28px;height:28px;background:var(--ps-primary-100);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:var(--ps-primary);">
                            @(userName?.Substring(0, 1).ToUpper())
                        </div>
                        <span class="d-none d-md-inline">@userName</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius: var(--ps-radius-lg); min-width: 200px;">
                        <li>
                            <div class="px-3 py-2 border-bottom">
                                <div class="fw-semibold small">@userName</div>
                                <div class="text-muted" style="font-size:11px;">@userRole</div>
                            </div>
                        </li>
                        @if (userRole == "Admin")
                        {
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="/admin">
                                    <i class="bi bi-shield-check text-primary"></i> @Loc["Nav.AdminPortal"]
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                        }
                        @if (userRole == "Owner")
                        {
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="/owner">
                                    <i class="bi bi-speedometer2 text-primary"></i> @Loc["Nav.OwnerDashboard"]
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                        }
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="/notifications">
                                <i class="bi bi-bell text-primary"></i> @Loc["Nav.Notifications"]
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="/bookings">
                                <i class="bi bi-calendar-check text-primary"></i> @Loc["Nav.MyBookings"]
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="/profile">
                                <i class="bi bi-person text-primary"></i> @Loc["Nav.Profile"]
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 text-danger" href="/logout">
                                <i class="bi bi-box-arrow-right"></i> @Loc["Nav.SignOut"]
                            </a>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a href="/login" class="ps-btn ps-btn-ghost ps-btn-sm d-none d-sm-flex">@Loc["Nav.SignIn"]</a>
                <a href="/register" class="ps-btn ps-btn-primary ps-btn-sm">
                    @Loc["Nav.GetStarted"] <i class="bi bi-arrow-right ms-1"></i>
                </a>
            }

            <!-- Mobile menu toggle -->
            <button id="ps-mobile-toggle" class="ps-mobile-toggle d-lg-none ms-1"
                    aria-label="Open navigation menu" aria-expanded="false" aria-controls="ps-mobile-menu">
                <i class="bi bi-list fs-5"></i>
            </button>
        </div>
    </div>
</nav>

<!-- Mobile menu -->
<div id="ps-mobile-menu" class="ps-mobile-menu" role="navigation" aria-label="Mobile navigation">
    <a class="ps-nav-link" href="/"><i class="bi bi-house-door me-2"></i>@Loc["Nav.Home"]</a>
    <a class="ps-nav-link" href="/venues"><i class="bi bi-building me-2"></i>@Loc["Nav.Venues"]</a>
    <a class="ps-nav-link" href="/venues"><i class="bi bi-trophy me-2"></i>@Loc["Nav.Sports"]</a>
    <a class="ps-nav-link" href="/games"><i class="bi bi-people me-2"></i>@Loc["Nav.Games"]</a>
    @if (loggedIn)
    {
        <hr class="my-2">
        <a class="ps-nav-link" href="/notifications"><i class="bi bi-bell me-2"></i>@Loc["Nav.Notifications"]</a>
        <a class="ps-nav-link" href="/bookings"><i class="bi bi-calendar-check me-2"></i>@Loc["Nav.MyBookings"]</a>
        @if (userRole == "Admin")
        {
            <a class="ps-nav-link" href="/admin"><i class="bi bi-shield-check me-2"></i>@Loc["Nav.AdminPortal"]</a>
        }
        @if (userRole == "Owner")
        {
            <a class="ps-nav-link" href="/owner"><i class="bi bi-speedometer2 me-2"></i>@Loc["Nav.OwnerDashboard"]</a>
        }
        <a class="ps-nav-link text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>@Loc["Nav.SignOut"]</a>
    }
    else
    {
        <hr class="my-2">
        <a class="ps-nav-link" href="/login"><i class="bi bi-person me-2"></i>@Loc["Nav.SignIn"]</a>
        <a class="ps-nav-link fw-semibold" href="/register" style="color:var(--ps-primary)">
            <i class="bi bi-person-plus me-2"></i>@Loc["Nav.GetStarted"]
        </a>
    }
</div>

<!-- ══════════════════════════════════════════════════════════
     MAIN CONTENT
     ══════════════════════════════════════════════════════════ -->
<main role="main">
    @RenderBody()
</main>

<!-- ══════════════════════════════════════════════════════════
     FOOTER
     ══════════════════════════════════════════════════════════ -->
<footer class="ps-footer" role="contentinfo">
    <div class="container">
        <div class="row g-4">

            <!-- Brand column -->
            <div class="col-lg-4 col-md-6 mb-4 mb-lg-0">
                <div class="ps-footer-brand">
                    <span>⚡</span> @Loc["Brand.Name"]
                </div>
                <p class="ps-footer-tagline mt-2">
                    @Loc["Brand.Tagline"]
                </p>
                <div class="d-flex gap-3 mt-4">
                    <a href="#" style="color:var(--ps-gray-500);" aria-label="Facebook">
                        <i class="bi bi-facebook fs-5"></i>
                    </a>
                    <a href="#" style="color:var(--ps-gray-500);" aria-label="Instagram">
                        <i class="bi bi-instagram fs-5"></i>
                    </a>
                    <a href="#" style="color:var(--ps-gray-500);" aria-label="Twitter">
                        <i class="bi bi-twitter-x fs-5"></i>
                    </a>
                </div>
            </div>

            <!-- Platform links -->
            <div class="col-lg-2 col-md-3 col-6">
                <h6 class="ps-footer-heading">@Loc["Nav.Venues"]</h6>
                <ul class="ps-footer-links">
                    <li><a href="/venues">@Loc["Nav.Venues"]</a></li>
                    <li><a href="/venues">@Loc["Nav.Sports"]</a></li>
                    <li><a href="/register">@Loc["Nav.GetStarted"]</a></li>
                </ul>
            </div>

            <!-- For Owners links -->
            <div class="col-lg-3 col-md-3 col-6">
                <h6 class="ps-footer-heading">@(Loc.IsArabic ? "لأصحاب المنشآت" : "For Facility Owners")</h6>
                <ul class="ps-footer-links">
                    <li><a href="/register">@(Loc.IsArabic ? "سجّل منشأتك الرياضية" : "List Your Facility")</a></li>
                    <li><a href="/owner">@Loc["Nav.OwnerDashboard"]</a></li>
                    <li><a href="/owner/venues">@(Loc.IsArabic ? "إدارة الملاعب والحجوزات" : "Manage Courts & Bookings")</a></li>
                </ul>
            </div>

            <!-- Sports links -->
            <div class="col-lg-3 col-md-6">
                <h6 class="ps-footer-heading">@Loc["Nav.Sports"]</h6>
                <ul class="ps-footer-links">
                    <li><a href="/venues?sport=Football">⚽ @Loc.Sport("Football")</a></li>
                    <li><a href="/venues?sport=Padel">🎾 @Loc.Sport("Padel")</a></li>
                    <li><a href="/venues?sport=Tennis">🏸 @Loc.Sport("Tennis")</a></li>
                    <li><a href="/venues?sport=Basketball">🏀 @Loc.Sport("Basketball")</a></li>
                    <li><a href="/venues?sport=Volleyball">🏐 @Loc.Sport("Volleyball")</a></li>
                    <li><a href="/venues?sport=Badminton">🏸 @Loc.Sport("Badminton")</a></li>
                </ul>
            </div>
        </div>

        <hr class="ps-footer-divider" />

        <div class="ps-footer-bottom d-flex flex-wrap justify-content-between align-items-center py-2">
            <p class="ps-footer-copy mb-0">
                &copy; @DateTime.Now.Year @Loc["Brand.Name"]. @(Loc.IsArabic ? "جميع الحقوق محفوظة." : "All rights reserved.")
            </p>
            <p class="ps-footer-copy mb-0">
                @(Loc.IsArabic ? "صُنع بـ ❤️ لمجتمع الرياضة في مصر." : "Made with ❤️ for the Egyptian sports community.")
            </p>
        </div>
    </div>
</footer>

<!-- ══════════════════════════════════════════════════════════
     SMART PLAYSPOT ASSISTANT
     ══════════════════════════════════════════════════════════ -->
<div id="ps-assistant-wrapper">
    <!-- Floating Trigger Button -->
    <button id="ps-assistant-btn" class="ps-assistant-trigger" type="button" aria-label="@(Loc.IsArabic ? "المساعد الذكي لبلاي سبوت" : "PlaySpot Smart Assistant")" title="@(Loc.IsArabic ? "مساعد بلاي سبوت الذكي" : "PlaySpot Smart Assistant")">
        <i class="bi bi-chat-dots-fill fs-4"></i>
        <span class="pulse-badge"></span>
    </button>

    <!-- Assistant Panel -->
    <div id="ps-assistant-panel" class="ps-assistant-panel" data-role="@(userRole ?? "Guest")" data-name="@(userName ?? "")" role="dialog" aria-modal="true" aria-label="@(Loc.IsArabic ? "مساعد بلاي سبوت" : "PlaySpot Assistant")">
        <div class="ps-assistant-header">
            <div class="d-flex align-items-center gap-2">
                <div style="width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,0.15);display:flex;align-items:center;justify-content:center;font-size:18px;">⚡</div>
                <div>
                    <h6 class="mb-0 fw-bold text-white" style="font-size:0.95rem;">@(Loc.IsArabic ? "مساعد بلاي سبوت" : "PlaySpot Assistant")</h6>
                    <small class="text-white-50" style="font-size:0.75rem;"><span class="d-inline-block rounded-circle bg-success me-1" style="width:7px;height:7px;"></span>@(Loc.IsArabic ? "متصل ومستعد للمساعدة" : "Online & ready")</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-1">
                <button type="button" id="ps-assistant-close" class="btn btn-link text-white-50 p-1" style="text-decoration:none;" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <div id="ps-assistant-body" class="ps-assistant-body">
            <!-- Dynamically populated by PlaySpot.Assistant -->
        </div>
    </div>
</div>

<!-- Bootstrap 5 JS Bundle -->
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>

<!-- PlaySpot Core JS -->
<script src="~/js/playspot.js" asp-append-version="true"></script>

<!-- Page-specific scripts -->
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>

