@page
@model CourtBook.Web.Pages.RegisterModel
@{
    ViewData["Title"] = $"{Loc["Auth.Register.Title"]} — {Loc["Brand.Name"]}";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm p-4" style="border-radius: var(--ps-radius-xl);">
            <div class="card-body">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-3 shadow-sm" style="width: 60px; height: 60px;">
                        <i class="bi bi-person-plus-fill fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-dark">@Loc["Auth.Register.Title"]</h3>
                    <p class="text-muted small">@Loc["Auth.Register.Subtitle"]</p>
                </div>
                
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                        <div>@Model.ErrorMessage</div>
                    </div>
                }
                
                <form method="post" id="registerForm">
                    <!-- Account Type Selection (Player vs Owner) -->
                    <div class="mb-4">
                        <label class="form-label text-dark fw-bold small mb-2">@Loc["Auth.Register.RoleTitle"] <span class="text-danger">*</span></label>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="card h-100 p-3 border cursor-pointer role-card border-primary bg-primary-subtle" id="roleCardClient" style="border-radius: 12px; cursor: pointer; transition: all 0.2s;">
                                    <input type="radio" asp-for="Input.Role" value="Client" class="d-none" id="radioRoleClient" checked onchange="handleRoleChange('Client')" />
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <i class="bi bi-person-badge-fill text-primary fs-5"></i>
                                        <span class="fw-bold text-dark small">@Loc["Auth.Register.RolePlayer"]</span>
                                    </div>
                                    <div class="text-muted" style="font-size: 11px; line-height: 1.3;">
                                        @Loc["Auth.Register.RolePlayerDesc"]
                                    </div>
                                </label>
                            </div>
                            <div class="col-6">
                                <label class="card h-100 p-3 border cursor-pointer role-card" id="roleCardOwner" style="border-radius: 12px; cursor: pointer; transition: all 0.2s;">
                                    <input type="radio" asp-for="Input.Role" value="Owner" class="d-none" id="radioRoleOwner" onchange="handleRoleChange('Owner')" />
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <i class="bi bi-building-fill text-success fs-5"></i>
                                        <span class="fw-bold text-dark small">@Loc["Auth.Register.RoleOwner"]</span>
                                    </div>
                                    <div class="text-muted" style="font-size: 11px; line-height: 1.3;">
                                        @Loc["Auth.Register.RoleOwnerDesc"]
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Full Name -->
                    <div class="mb-3">
                        <label asp-for="Input.Name" class="form-label text-dark fw-semibold small mb-1">@Loc["Profile.Field.Name"] <span class="text-danger">*</span></label>
                        <span class="ps-form-helper mb-1">@Loc["Profile.Field.Name.Helper"]</span>
                        <span class="ps-form-example mb-2">@Loc["Profile.Field.Name.Example"]</span>
                        <input asp-for="Input.Name" class="form-control bg-light border-0 shadow-none py-2 rounded-3" placeholder="@Loc["Profile.Field.Name.Example"]" required />
                        <span asp-validation-for="Input.Name" class="text-danger small"></span>
                    </div>

                    <!-- Email Address -->
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label text-dark fw-semibold small mb-1">@Loc["Auth.Login.EmailLabel"] <span class="text-danger">*</span></label>
                        <span class="ps-form-helper mb-1">@Loc["Auth.Login.EmailHelper"]</span>
                        <span class="ps-form-example mb-2">@Loc["Auth.Login.EmailExample"]</span>
                        <input asp-for="Input.Email" class="form-control bg-light border-0 shadow-none py-2 rounded-3" type="email" placeholder="@Loc["Auth.Login.EmailExample"]" required />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    
                    <!-- Phone Number -->
                    <div class="mb-3">
                        <label asp-for="Input.Phone" class="form-label text-dark fw-semibold small mb-1">@Loc["Profile.Field.Phone"]</label>
                        <span class="ps-form-helper mb-1">@Loc["Profile.Field.Phone.Helper"]</span>
                        <span class="ps-form-example mb-2">@Loc["Profile.Field.Phone.Example"]</span>
                        <input asp-for="Input.Phone" class="form-control bg-light border-0 shadow-none py-2 rounded-3" placeholder="@Loc["Profile.Field.Phone.Example"]" />
                        <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                    </div>
                    
                    <!-- Password -->
                    <div class="mb-2 position-relative">
                        <label asp-for="Input.Password" class="form-label text-dark fw-semibold small mb-1">@Loc["Auth.Register.PasswordLabel"] <span class="text-danger">*</span></label>
                        <span class="ps-form-helper mb-1">@Loc["Auth.Register.PasswordHelper"]</span>
                        <span class="ps-form-example mb-2">@Loc["Auth.Register.PasswordExample"]</span>
                        <div class="position-relative">
                            <input asp-for="Input.Password" class="form-control bg-light border-0 shadow-none py-2 rounded-3" type="password" placeholder="••••••••" required id="regPassword" />
                            <button class="btn btn-link position-absolute top-50 end-0 translate-middle-y text-muted text-decoration-none" type="button" id="togglePassword">
                                <i class="bi bi-eye-fill"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                    
                    <!-- Password Strength -->
                    <div class="progress mb-1 mt-2" style="height: 5px;">
                        <div class="progress-bar bg-danger" role="progressbar" id="pwStrengthBar" style="width: 0%"></div>
                    </div>
                    <div class="d-flex justify-content-between mb-4">
                        <small class="text-muted" id="pwStrengthText">@(Loc.IsArabic ? "قوة كلمة المرور" : "Strength")</small>
                    </div>

                    <!-- Terms Acceptance Checkbox -->
                    <div class="mb-4 p-3 bg-light rounded-3 border border-light-subtle">
                        <div class="form-check d-flex align-items-start gap-2 mb-0">
                            <input asp-for="Input.AcceptTerms" class="form-check-input mt-1" type="checkbox" id="acceptTermsCheck" required />
                            <label class="form-check-label small text-muted" for="acceptTermsCheck">
                                @Loc["Auth.Register.TermsPrompt"]
                                <a href="javascript:void(0)" class="text-primary fw-semibold text-decoration-none" id="termsLink" onclick="openTermsModal()">
                                    <span id="termsLinkPlayer">@Loc["Auth.Register.TermsPlayerLink"]</span>
                                    <span id="termsLinkOwner" class="d-none">@Loc["Auth.Register.TermsOwnerLink"]</span>
                                </a>
                                <span class="text-danger">*</span>
                            </label>
                        </div>
                        <span asp-validation-for="Input.AcceptTerms" class="text-danger small d-block mt-1"></span>
                    </div>

                    <button type="submit" class="ps-btn ps-btn-primary w-100 py-3 fw-bold shadow-sm" id="regBtn">
                        @Loc["Auth.Register.Btn"]
                    </button>
                </form>
                
                <div class="text-center mt-4 pt-3 border-top">
                    <p class="text-muted mb-0 small">
                        @Loc["Auth.Register.HaveAccount"] <a asp-page="/Login" class="text-primary text-decoration-none fw-bold">@Loc["Nav.SignIn"]</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Legal Terms Modal -->
<div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: var(--ps-radius-xl);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="termsModalLabel">@Loc["Auth.Register.TermsModalTitle"]</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div id="termsLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
                <div id="termsContent" class="text-muted small" style="white-space: pre-wrap; line-height: 1.6; display: none;"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">@Loc["Auth.Register.CloseModal"]</button>
                <button type="button" class="ps-btn ps-btn-primary rounded-pill px-4" onclick="acceptAndCloseTerms()">@Loc["Auth.Register.AcceptModal"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let currentRole = "Client";
        let termsModalInstance = null;

        function handleRoleChange(role) {
            currentRole = role;
            const cardClient = document.getElementById('roleCardClient');
            const cardOwner = document.getElementById('roleCardOwner');
            const linkPlayer = document.getElementById('termsLinkPlayer');
            const linkOwner = document.getElementById('termsLinkOwner');

            if (role === 'Owner') {
                cardOwner.className = 'card h-100 p-3 border cursor-pointer role-card border-success bg-success-subtle';
                cardClient.className = 'card h-100 p-3 border cursor-pointer role-card border-light-subtle bg-white';
                if (linkPlayer) linkPlayer.classList.add('d-none');
                if (linkOwner) linkOwner.classList.remove('d-none');
            } else {
                cardClient.className = 'card h-100 p-3 border cursor-pointer role-card border-primary bg-primary-subtle';
                cardOwner.className = 'card h-100 p-3 border cursor-pointer role-card border-light-subtle bg-white';
                if (linkPlayer) linkPlayer.classList.remove('d-none');
                if (linkOwner) linkOwner.classList.add('d-none');
            }
        }

        async function openTermsModal() {
            const modalEl = document.getElementById('termsModal');
            if (!termsModalInstance) {
                termsModalInstance = new bootstrap.Modal(modalEl);
            }
            termsModalInstance.show();

            const loading = document.getElementById('termsLoading');
            const content = document.getElementById('termsContent');
            const modalTitle = document.getElementById('termsModalLabel');
            loading.style.display = 'block';
            content.style.display = 'none';

            const typeName = currentRole === 'Owner' ? 'FacilityOwner' : 'Player';
            try {
                const res = await fetch(`/api/terms/${typeName}`);
                if (res.ok) {
                    const data = await res.json();
                    modalTitle.textContent = data.title;
                    content.textContent = data.content;
                } else {
                    content.textContent = "Terms and conditions are currently unavailable. Please check back later.";
                }
            } catch (err) {
                content.textContent = "Unable to load terms at this moment. Please verify your connection.";
            } finally {
                loading.style.display = 'none';
                content.style.display = 'block';
            }
        }

        function acceptAndCloseTerms() {
            const check = document.getElementById('acceptTermsCheck');
            if (check) check.checked = true;
            if (termsModalInstance) termsModalInstance.hide();
        }

        document.addEventListener('DOMContentLoaded', function() {
            const togglePassword = document.querySelector('#togglePassword');
            const password = document.querySelector('#regPassword');
            const strengthBar = document.querySelector('#pwStrengthBar');
            const strengthText = document.querySelector('#pwStrengthText');
            const isAr = @(Loc.IsArabic ? "true" : "false");

            if (togglePassword && password) {
                togglePassword.addEventListener('click', function (e) {
                    const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
                    password.setAttribute('type', type);
                    this.querySelector('i').classList.toggle('bi-eye-fill');
                    this.querySelector('i').classList.toggle('bi-eye-slash-fill');
                });
            }

            if (password && strengthBar && strengthText) {
                password.addEventListener('input', function() {
                    const val = password.value;
                    let strength = 0;
                    
                    if(val.length >= 8) strength += 20;
                    if(val.match(/[a-z]+/)) strength += 20;
                    if(val.match(/[A-Z]+/)) strength += 20;
                    if(val.match(/[0-9]+/)) strength += 20;
                    if(val.match(/[!@@#$%^&*(),.?"':{}|<>\-_=+\\/\[\]~]+/)) strength += 20;

                    if(val.length === 0) strength = 0;
                    if(strength > 100) strength = 100;

                    strengthBar.style.width = strength + '%';

                    if(strength < 40) {
                        strengthBar.className = 'progress-bar bg-danger';
                        strengthText.textContent = isAr ? 'ضعيفة (يجب إضافة حروف كبيرة وصغيرة وأرقام ورموز خاصة)' : 'Weak (requires uppercase, lowercase, numbers & symbols)';
                        strengthText.className = 'text-danger small fw-bold';
                    } else if(strength < 80) {
                        strengthBar.className = 'progress-bar bg-warning';
                        strengthText.textContent = isAr ? 'متوسطة (أضف رموزاً وأحرفاً إضافية)' : 'Medium (add more symbols & characters)';
                        strengthText.className = 'text-warning small fw-bold';
                    } else {
                        strengthBar.className = 'progress-bar bg-success';
                        strengthText.textContent = isAr ? 'قوية ومحمية بالكامل 🔒' : 'Strong & Fully Protected 🔒';
                        strengthText.className = 'text-success small fw-bold';
                    }
                });
            }
        });
    </script>
}

