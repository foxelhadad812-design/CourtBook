@page
@model CourtBook.Web.Pages.RegisterModel
@{
    ViewData["Title"] = $"{Loc["Auth.Register.Title"]} — {Loc["Brand.Name"]}";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm p-4" style="border-radius: var(--ps-radius-xl);">
            <div class="card-body">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-3 shadow-sm" style="width: 60px; height: 60px;">
                        <i class="bi bi-person-plus-fill fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-dark">@Loc["Auth.Register.Title"]</h3>
                    <p class="text-muted small">@Loc["Auth.Register.Subtitle"]</p>
                </div>
                
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                        <div>@Model.ErrorMessage</div>
                    </div>
                }
                
                <form method="post" id="registerForm">
                    <!-- Full Name -->
                    <div class="mb-3">
                        <label asp-for="Input.Name" class="form-label text-dark fw-semibold small mb-1">@Loc["Profile.Field.Name"] <span class="text-danger">*</span></label>
                        <span class="ps-form-helper mb-1">@Loc["Profile.Field.Name.Helper"]</span>
                        <span class="ps-form-example mb-2">@Loc["Profile.Field.Name.Example"]</span>
                        <input asp-for="Input.Name" class="form-control bg-light border-0 shadow-none py-2 rounded-3" placeholder="@Loc["Profile.Field.Name.Example"]" required />
                        <span asp-validation-for="Input.Name" class="text-danger small"></span>
                    </div>

                    <!-- Email Address -->
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label text-dark fw-semibold small mb-1">@Loc["Auth.Login.EmailLabel"] <span class="text-danger">*</span></label>
                        <span class="ps-form-helper mb-1">@Loc["Auth.Login.EmailHelper"]</span>
                        <span class="ps-form-example mb-2">@Loc["Auth.Login.EmailExample"]</span>
                        <input asp-for="Input.Email" class="form-control bg-light border-0 shadow-none py-2 rounded-3" type="email" placeholder="@Loc["Auth.Login.EmailExample"]" required />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    
                    <!-- Phone Number -->
                    <div class="mb-3">
                        <label asp-for="Input.Phone" class="form-label text-dark fw-semibold small mb-1">@Loc["Profile.Field.Phone"]</label>
                        <span class="ps-form-helper mb-1">@Loc["Profile.Field.Phone.Helper"]</span>
                        <span class="ps-form-example mb-2">@Loc["Profile.Field.Phone.Example"]</span>
                        <input asp-for="Input.Phone" class="form-control bg-light border-0 shadow-none py-2 rounded-3" placeholder="@Loc["Profile.Field.Phone.Example"]" />
                        <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                    </div>
                    
                    <!-- Password -->
                    <div class="mb-2 position-relative">
                        <label asp-for="Input.Password" class="form-label text-dark fw-semibold small mb-1">@Loc["Auth.Register.PasswordLabel"] <span class="text-danger">*</span></label>
                        <span class="ps-form-helper mb-1">@Loc["Auth.Register.PasswordHelper"]</span>
                        <span class="ps-form-example mb-2">@Loc["Auth.Register.PasswordExample"]</span>
                        <div class="position-relative">
                            <input asp-for="Input.Password" class="form-control bg-light border-0 shadow-none py-2 rounded-3" type="password" placeholder="••••••••" required id="regPassword" />
                            <button class="btn btn-link position-absolute top-50 end-0 translate-middle-y text-muted text-decoration-none" type="button" id="togglePassword">
                                <i class="bi bi-eye-fill"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                    
                    <!-- Password Strength -->
                    <div class="progress mb-1 mt-2" style="height: 5px;">
                        <div class="progress-bar bg-danger" role="progressbar" id="pwStrengthBar" style="width: 0%"></div>
                    </div>
                    <div class="d-flex justify-content-between mb-4">
                        <small class="text-muted" id="pwStrengthText">@(Loc.IsArabic ? "قوة كلمة المرور" : "Strength")</small>
                    </div>

                    <button type="submit" class="ps-btn ps-btn-primary w-100 py-3 fw-bold shadow-sm" id="regBtn">
                        @Loc["Auth.Register.Btn"]
                    </button>
                </form>
                
                <div class="text-center mt-4 pt-3 border-top">
                    <p class="text-muted mb-0 small">
                        @Loc["Auth.Register.HaveAccount"] <a asp-page="/Login" class="text-primary text-decoration-none fw-bold">@Loc["Nav.SignIn"]</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const togglePassword = document.querySelector('#togglePassword');
            const password = document.querySelector('#regPassword');
            const strengthBar = document.querySelector('#pwStrengthBar');
            const strengthText = document.querySelector('#pwStrengthText');
            const isAr = @(Loc.IsArabic ? "true" : "false");

            if (togglePassword && password) {
                togglePassword.addEventListener('click', function (e) {
                    const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
                    password.setAttribute('type', type);
                    this.querySelector('i').classList.toggle('bi-eye-fill');
                    this.querySelector('i').classList.toggle('bi-eye-slash-fill');
                });
            }

            if (password && strengthBar && strengthText) {
                password.addEventListener('input', function() {
                    const val = password.value;
                    let strength = 0;
                    
                    if(val.length >= 8) strength += 20;
                    if(val.match(/[a-z]+/)) strength += 20;
                    if(val.match(/[A-Z]+/)) strength += 20;
                    if(val.match(/[0-9]+/)) strength += 20;
                    if(val.match(/[!@@#$%^&*(),.?"':{}|<>\-_=+\\/\[\]~]+/)) strength += 20;

                    if(val.length === 0) strength = 0;
                    if(strength > 100) strength = 100;

                    strengthBar.style.width = strength + '%';

                    if(strength < 40) {
                        strengthBar.className = 'progress-bar bg-danger';
                        strengthText.textContent = isAr ? 'ضعيفة (يجب إضافة حروف كبيرة وصغيرة وأرقام ورموز خاصة)' : 'Weak (requires uppercase, lowercase, numbers & symbols)';
                        strengthText.className = 'text-danger small fw-bold';
                    } else if(strength < 80) {
                        strengthBar.className = 'progress-bar bg-warning';
                        strengthText.textContent = isAr ? 'متوسطة (أضف رموزاً وأحرفاً إضافية)' : 'Medium (add more symbols & characters)';
                        strengthText.className = 'text-warning small fw-bold';
                    } else {
                        strengthBar.className = 'progress-bar bg-success';
                        strengthText.textContent = isAr ? 'قوية ومحمية بالكامل 🔒' : 'Strong & Fully Protected 🔒';
                        strengthText.className = 'text-success small fw-bold';
                    }
                });
            }
        });
    </script>
}
