@page "{id:guid}"
@model CourtBook.Web.Pages.Courts.BookModel
@{
    ViewData["Title"] = "Book Court";
}

@if (Model.Court != null)
{
    <div class="container py-4">
        <div class="mb-4">
            <a href="javascript:history.back()" class="text-decoration-none text-muted fw-medium"><i class="bi bi-arrow-left me-1"></i> Back to Venue</a>
        </div>
        
        <div class="row g-5">
            <!-- Left Column: Court Info -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm mb-4 overflow-hidden">
                    @{
                        var badgeClass = Model.Court.SportType.ToLower() switch
                        {
                            "football" => "badge-football",
                            "padel" => "badge-padel",
                            "tennis" => "badge-tennis",
                            _ => "bg-secondary"
                        };
                        var courtBookImg = Model.Court.SportType.ToLower() switch
                        {
                            "football" => "/images/football.jpg",
                            "padel" => "/images/padel.jpg",
                            "tennis" => "/images/tennis.jpg",
                            "basketball" => "/images/basketball.jpg",
                            _ => "/images/venue.jpg"
                        };
                    }
                    <div class="position-relative" style="height: 180px;">
                        <img src="@courtBookImg" alt="@Model.Court.SportType court" class="w-100 h-100 object-fit-cover" style="display: block;">
                        <div class="position-absolute top-0 end-0 p-3">
                            <span class="badge @badgeClass rounded-pill px-3 py-2 shadow-sm">@Model.Court.SportType</span>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-4 pb-4 border-bottom">
                            <h2 class="fw-bold mb-2">@Model.Court.Name</h2>
                            <span class="fs-2 fw-bolder text-primary">$@Model.Court.PricePerHour</span>
                            <span class="text-muted">/ hr</span>
                            <input type="hidden" id="pricePerHour" value="@Model.Court.PricePerHour" />
                        </div>

                        <h5 class="fw-bold mb-3"><i class="bi bi-clock me-2 text-primary"></i> Working Hours</h5>
                        <ul class="list-group list-group-flush">
                            @if (Model.Court.Schedules.Any())
                            {
                                @foreach (var s in Model.Court.Schedules.OrderBy(x => x.DayOfWeek))
                                {
                                    <li class="list-group-item d-flex justify-content-between px-0 py-2 border-0">
                                        <span class="fw-medium">@(((DayOfWeek)s.DayOfWeek).ToString())</span>
                                        <span class="text-muted">@s.OpenTime - @s.CloseTime</span>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="list-group-item px-0 border-0 text-muted">No schedule defined.</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Right Column: Booking Form -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5">
                        <h3 class="fw-bold mb-4">Select your time</h3>
                        
                        <form method="post" id="bookingForm">
                            <div class="mb-4">
                                <label class="form-label fw-bold">Date</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-white"><i class="bi bi-calendar-event text-primary"></i></span>
                                    <input asp-for="BookingDate" class="form-control bg-light border-start-0" type="date" required id="bookingDate" />
                                </div>
                            </div>
                            
                            <div class="row g-4 mb-4">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Start Time</label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text bg-white"><i class="bi bi-clock text-primary"></i></span>
                                        <input asp-for="StartTime" class="form-control bg-light border-start-0 time-input" type="time" required id="startTime" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">End Time</label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text bg-white"><i class="bi bi-clock-history text-primary"></i></span>
                                        <input asp-for="EndTime" class="form-control bg-light border-start-0 time-input" type="time" required id="endTime" />
                                    </div>
                                </div>
                            </div>

                            <div class="p-4 bg-light rounded-4 mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted fw-medium">Duration</span>
                                    <span class="fw-bold" id="calcDuration">1 hr 0 min</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted fw-medium">Total Price</span>
                                    <span class="fs-4 fw-bolder text-primary" id="calcTotal">$@Model.Court.PricePerHour</span>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 btn-lg py-3 fw-bold rounded-pill shadow-sm" id="submitBtn">
                                Confirm Booking
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const startTimeInput = document.getElementById('startTime');
            const endTimeInput = document.getElementById('endTime');
            const durationEl = document.getElementById('calcDuration');
            const totalEl = document.getElementById('calcTotal');
            const submitBtn = document.getElementById('submitBtn');
            const pricePerHour = parseFloat(document.getElementById('pricePerHour').value);
            const form = document.getElementById('bookingForm');

            function updateCalculator() {
                if (!startTimeInput.value || !endTimeInput.value) return;
                
                const start = new Date(`2000-01-01T${startTimeInput.value}`);
                const end = new Date(`2000-01-01T${endTimeInput.value}`);
                
                let diffMs = end - start;
                
                if (diffMs <= 0) {
                    durationEl.textContent = "Invalid times";
                    totalEl.textContent = "$0.00";
                    submitBtn.disabled = true;
                    return;
                }
                
                submitBtn.disabled = false;
                
                const diffHrs = Math.floor(diffMs / 3600000);
                const diffMins = Math.round((diffMs % 3600000) / 60000);
                
                durationEl.textContent = `${diffHrs} hr ${diffMins} min`;
                
                const totalHours = diffMs / 3600000;
                const totalPrice = (totalHours * pricePerHour).toFixed(2);
                totalEl.textContent = `$${totalPrice}`;
            }

            startTimeInput.addEventListener('change', updateCalculator);
            endTimeInput.addEventListener('change', updateCalculator);
            
            form.addEventListener('submit', function() {
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Processing...';
                submitBtn.classList.add('disabled');
            });
            
            // Initial calc
            updateCalculator();
        });
    </script>
}
