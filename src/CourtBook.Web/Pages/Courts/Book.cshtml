            border: 2px solid var(--ps-border-color, #E2E8F0) !important;
            user-select: none;
            background: var(--ps-card-bg, #ffffff);
        }
        .slot-card.slot-available {
            border-color: #10B981 !important;
            border-width: 2px !important;
        }
