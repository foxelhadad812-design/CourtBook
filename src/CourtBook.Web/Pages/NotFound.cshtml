@page
@{
    ViewData["Title"] = "Page Not Found";
}

<div class="container py-5 text-center my-5">
    <div class="empty-state">
        <h1 class="display-1 fw-bolder text-primary mb-3">404</h1>
        <h2 class="fw-bold mb-3">Oops! Page not found.</h2>
        <p class="lead text-muted mb-5">The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.</p>
        <a asp-page="/Index" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">Go Home</a>
    </div>
</div>
