@page
@model CourtBook.Web.Pages.Payments.PayModel
@{
    ViewData["Title"] = "Complete Payment";
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
    var dir = isArabic ? "rtl" : "ltr";
}

<div dir="@dir" class="container py-5" style="max-width:640px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0">
                <i class="bi bi-credit-card me-2"></i>
                @(isArabic ? "اختر طريقة الدفع" : "Select Payment Method")
            </h4>
        </div>
        <div class="card-body p-4">

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle me-1"></i>@Model.ErrorMessage
                </div>
            }

            @* Booking Summary *@
            <div class="bg-light rounded p-3 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small">@(isArabic ? "رقم الحجز" : "Booking")</span>
                    <strong class="font-monospace">@Model.BookingReference</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">@(isArabic ? "الملعب" : "Court")</span>
                    <span>@Model.CourtName — @Model.VenueName</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">@(isArabic ? "الوقت" : "Time")</span>
                    <span>@Model.StartTime.ToString("ddd d MMM, HH:mm") → @Model.EndTime.ToString("HH:mm")</span>
                </div>
                <hr class="my-2" />
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold">@(isArabic ? "الإجمالي" : "Total")</span>
                    <span class="fs-5 fw-bold text-success">EGP @Model.TotalPrice.ToString("0.00")</span>
                </div>
                <div class="text-muted small mt-1">
                    <i class="bi bi-shield-check me-1 text-success"></i>
                    @(isArabic ? "السعر محسوب من الخادم — لا يمكن التلاعب به" : "Price calculated server-side — tamper-proof")
                </div>
            </div>

            @* Payment Method Selection *@
            <form method="post">
                <input type="hidden" name="bookingId" value="@Model.BookingId" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">@(isArabic ? "طريقة الدفع" : "Payment Method")</label>

                    <div class="list-group">
                        <label class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                            <input class="form-check-input" type="radio" name="paymentMethod"
                                   value="PayAtFacility" checked />
                            <i class="bi bi-cash-stack fs-4 text-success"></i>
                            <div>
                                <div class="fw-semibold">@(isArabic ? "الدفع في المكان" : "Pay at Facility")</div>
                                <div class="text-muted small">@(isArabic ? "ادفع نقداً عند الوصول" : "Pay cash on arrival")</div>
                            </div>
                        </label>

                        <label class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                            <input class="form-check-input" type="radio" name="paymentMethod"
                                   value="CreditCard" />
                            <i class="bi bi-credit-card fs-4 text-primary"></i>
                            <div>
                                <div class="fw-semibold">@(isArabic ? "بطاقة ائتمانية / فيزا / ماستر" : "Credit / Debit Card")</div>
                                <div class="text-muted small">@(isArabic ? "دفع آمن عبر Paymob" : "Secure online via Paymob")</div>
                            </div>
                            <span class="badge bg-info ms-auto">@(isArabic ? "مباشر" : "Instant")</span>
                        </label>

                        <label class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                            <input class="form-check-input" type="radio" name="paymentMethod"
                                   value="Fawry" />
                            <i class="bi bi-shop fs-4 text-warning"></i>
                            <div>
                                <div class="fw-semibold">Fawry</div>
                                <div class="text-muted small">@(isArabic ? "ادفع من أي نقطة فوري" : "Pay at any Fawry outlet")</div>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="alert alert-warning py-2 small">
                    <i class="bi bi-clock me-1"></i>
                    @(isArabic
                        ? "للدفع الإلكتروني: لديك 10 دقائق لإكمال العملية قبل انتهاء صلاحية الحجز."
                        : "For online payment: you have 10 minutes to complete checkout before your hold expires.")
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-lock me-2"></i>
                        @(isArabic ? "تأكيد الدفع" : "Confirm Payment")
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
