@page
@model CourtBook.Web.Pages.Payments.SuccessModel
@{
    ViewData["Title"] = Model.PaymentConfirmed ? "Payment Successful" : "Payment Pending";
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
    var dir = isArabic ? "rtl" : "ltr";
}

<div dir="@dir" class="container py-5" style="max-width:560px;">
    <div class="text-center">

        @if (Model.PaymentConfirmed)
        {
            <div class="text-success mb-3" style="font-size:5rem;">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <h2 class="fw-bold mb-2">@(isArabic ? "تم الدفع بنجاح!" : "Payment Successful!")</h2>
            <p class="text-muted">
                @(isArabic ? "تم تأكيد حجزك ودفعك بنجاح." : "Your booking and payment have been confirmed.")
            </p>

            @if (!string.IsNullOrEmpty(Model.BookingReference))
            {
                <div class="bg-light rounded p-3 mb-3 text-start">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">@(isArabic ? "رقم الحجز" : "Booking Ref")</span>
                        <strong class="font-monospace">@Model.BookingReference</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">@(isArabic ? "المبلغ" : "Amount Paid")</span>
                        <strong class="text-success">EGP @Model.Amount.ToString("0.00")</strong>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.TransactionReference))
                    {
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">@(isArabic ? "رقم المعاملة" : "Transaction Ref")</span>
                            <span class="font-monospace small">@Model.TransactionReference</span>
                        </div>
                    }
                </div>
            }

            <div class="d-grid gap-2 mt-4">
                <a href="/Bookings/Details?id=@Model.BookingId" class="btn btn-primary">
                    <i class="bi bi-calendar-check me-2"></i>@(isArabic ? "تفاصيل الحجز" : "View Booking Details")
                </a>
                <a href="/Bookings" class="btn btn-outline-secondary">
                    @(isArabic ? "حجوزاتي" : "My Bookings")
                </a>
            </div>
        }
        else
        {
            <div class="text-warning mb-3" style="font-size:5rem;">
                <i class="bi bi-exclamation-circle-fill"></i>
            </div>
            <h2 class="fw-bold mb-2">@(isArabic ? "لم يُكتمل الدفع" : "Payment Not Confirmed")</h2>
            <p class="text-muted">
                @(isArabic
                    ? "لم نتمكن من التحقق من الدفع. إذا خُصمت الأموال، يرجى التواصل معنا."
                    : "We could not verify your payment. If funds were deducted, please contact support.")
            </p>
            <div class="d-grid gap-2 mt-4">
                <a href="/Bookings" class="btn btn-outline-primary">
                    @(isArabic ? "حجوزاتي" : "My Bookings")
                </a>
                <a href="/Contact" class="btn btn-outline-secondary">
                    @(isArabic ? "تواصل معنا" : "Contact Support")
                </a>
            </div>
        }

    </div>
</div>
