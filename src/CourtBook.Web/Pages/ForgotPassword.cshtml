@page
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5 my-5 text-center">
    <div class="empty-state">
        <div class="d-inline-flex align-items-center justify-content-center bg-light text-primary rounded-circle mb-4" style="width: 80px; height: 80px;">
            <i class="bi bi-tools fs-1"></i>
        </div>
        <h2 class="fw-bold mb-3">Feature Coming Soon</h2>
        <p class="lead text-muted mb-4">We're working hard on bringing you this feature. Stay tuned!</p>
        <a asp-page="/Login" class="btn btn-primary rounded-pill px-4">&larr; Back to Login</a>
    </div>
</div>
