@page "/Owner/Venues"
@model CourtBook.Web.Pages.Owner.Venues.IndexModel
@{
    ViewData["Title"] = $"{Loc["Owner.Venues.Title"]} — {Loc["Brand.Name"]}";
}

<div class="owner-venues-page py-4">
    <div class="container-xl">
        @if (!Model.IsOwner)
        {
            <div class="card border-0 shadow-lg text-center p-5 my-5" style="border-radius: var(--ps-radius-2xl);">
                <div class="display-1 text-danger mb-3">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h2 class="text-dark fw-bold mb-2">@(Loc.IsArabic ? "صلاحيات المالك مطلوبة" : "Access Restricted")</h2>
                <p class="text-muted mx-auto mb-4" style="max-width: 500px;">
                    @(Loc.IsArabic ? "هذا القسم مخصص لأصحاب ومسؤولي المنشآت الرياضية المسجلين. يرجى تسجيل الدخول بحساب المالك." : "This section is reserved for verified sports facility owners. To register as an owner or manage your venues, please log in with an owner account.")
                </p>
                <div>
                    <a href="/Login?returnUrl=/Owner/Venues" class="ps-btn ps-btn-primary px-4 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-2"></i>@Loc["Nav.SignIn"]
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Page Header -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 border-bottom">
                <div>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-1">
                            <li class="breadcrumb-item"><a href="/Owner" class="text-muted text-decoration-none">@Loc["Nav.OwnerDashboard"]</a></li>
                            <li class="breadcrumb-item active text-dark" aria-current="page">@Loc["Owner.Venues.Title"]</li>
                        </ol>
                    </nav>
                    <h1 class="h3 text-dark fw-bold mb-1">@Loc["Owner.Venues.Title"]</h1>
                    <p class="text-muted mb-0 small">@(Loc.IsArabic ? "نظرة شاملة على جميع منشآتك الرياضية، الملاعب، والحالة التشغيلية." : "Overview of all your sports venues, courts, and operational status.")</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="/Owner" class="btn btn-outline-secondary rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i> @Loc["Nav.OwnerDashboard"]
                    </a>
                    <a href="/Owner/Venues/Create" class="ps-btn ps-btn-primary rounded-pill px-4 shadow-sm fw-semibold">
                        <i class="bi bi-plus-circle me-1"></i> @Loc["Owner.Venues.AddBtn"]
                    </a>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger d-flex align-items-center rounded-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div>@Model.ErrorMessage</div>
                </div>
            }

            <!-- KPI Mini Bar -->
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm p-3 h-100" style="border-radius: 14px;">
                        <div class="text-muted small fw-medium">@Loc["Owner.Kpi.Venues"]</div>
                        <div class="h3 text-dark fw-bold mb-0 mt-1">@Model.Venues.Count</div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm p-3 h-100" style="border-radius: 14px;">
                        <div class="text-muted small fw-medium">@(Loc.IsArabic ? "المنشآت النشطة" : "Active Facilities")</div>
                        <div class="h3 text-success fw-bold mb-0 mt-1">@Model.Venues.Count(v => v.IsActive)</div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm p-3 h-100" style="border-radius: 14px;">
                        <div class="text-muted small fw-medium">@Loc["Owner.Kpi.Courts"]</div>
                        <div class="h3 text-info fw-bold mb-0 mt-1">@Model.Venues.Sum(v => v.TotalCourts)</div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm p-3 h-100" style="border-radius: 14px;">
                        <div class="text-muted small fw-medium">@Loc["Owner.Kpi.Upcoming"]</div>
                        <div class="h3 text-warning fw-bold mb-0 mt-1">@Model.Venues.Sum(v => v.UpcomingBookingsCount)</div>
                    </div>
                </div>
            </div>

            <!-- Facilities Grid -->
            @if (Model.Venues.Count == 0)
            {
                <div class="card border-0 shadow-sm text-center p-5" style="border-radius: 20px;">
                    <div class="display-3 text-muted mb-3"><i class="bi bi-building-add"></i></div>
                    <h4 class="text-dark fw-bold mb-2">@(Loc.IsArabic ? "لم تضف منشآت رياضية بعد" : "No Facilities Added Yet")</h4>
                    <p class="text-muted mx-auto mb-4" style="max-width: 450px;">
                        @Loc["Home.OwnerCta.Subtitle"]
                    </p>
                    <div>
                        <a href="/Owner/Venues/Create" class="ps-btn ps-btn-primary rounded-pill px-4 py-2 fw-semibold">
                            <i class="bi bi-plus-lg me-1"></i> @Loc["Owner.Venues.AddBtn"]
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var venue in Model.Venues)
                    {
                        var firstSport = venue.Sports.FirstOrDefault()?.ToLowerInvariant() ?? "football";
                        var defaultPhoto = firstSport switch {
                            "football" => "/images/venues/football/football-pitch-01.jpg",
                            "padel" => "/images/venues/padel/padel-court-01.jpg",
                            "tennis" => "/images/venues/tennis/tennis-clay-01.jpg",
                            "basketball" => "/images/venues/basketball/basketball-indoor-01.jpg",
                            "volleyball" => "/images/venues/volleyball/volleyball-indoor-01.jpg",
                            "badminton" => "/images/venues/badminton/badminton-court-01.jpg",
                            _ => "/images/venues/fallbacks/venue-fallback.jpg"
                        };
                        var photoUrl = !string.IsNullOrEmpty(venue.PrimaryImageUrl) ? venue.PrimaryImageUrl : defaultPhoto;
                        var fallbackPhoto = $"/images/venues/fallbacks/{firstSport}-fallback.jpg";

                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 border-0 shadow-sm overflow-hidden" style="border-radius: var(--ps-radius-xl); transition: transform 0.2s ease, box-shadow 0.2s ease;">
                                <!-- Image Header with Badges (16:9) -->
                                <div class="position-relative ps-venue-card-img-wrapper" style="height: 180px;">
                                    <img src="@photoUrl" alt="@venue.Name" class="w-100 h-100 object-fit-cover" data-fallback="@fallbackPhoto" onerror="PlaySpot.ImageFallback.handleError(this, '@fallbackPhoto')" />
                                    <div class="position-absolute top-0 end-0 p-2 d-flex flex-wrap gap-1 justify-content-end">
                                        <!-- Approval Status Badge -->
                                        @if (venue.ApprovalStatus == CourtBook.Domain.Enums.VenueApprovalStatus.Approved)
                                        {
                                            <span class="badge bg-success bg-opacity-90 px-2 py-1 small rounded-pill">
                                                <i class="bi bi-patch-check-fill me-1"></i> @Loc["ApprovalStatus.Approved"]
                                            </span>
                                        }
                                        else if (venue.ApprovalStatus == CourtBook.Domain.Enums.VenueApprovalStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark bg-opacity-90 px-2 py-1 small rounded-pill">
                                                <i class="bi bi-hourglass-split me-1"></i> @Loc["ApprovalStatus.Pending"]
                                            </span>
                                        }
                                        else if (venue.ApprovalStatus == CourtBook.Domain.Enums.VenueApprovalStatus.Rejected)
                                        {
                                            <span class="badge bg-danger bg-opacity-90 px-2 py-1 small rounded-pill">
                                                <i class="bi bi-x-circle-fill me-1"></i> @Loc["ApprovalStatus.Rejected"]
                                            </span>
                                        }

                                        <!-- Operational State -->
                                        @if (venue.IsActive)
                                        {
                                            <span class="badge bg-dark bg-opacity-75 px-2 py-1 small rounded-pill">
                                                <i class="bi bi-check-circle me-1"></i> @(Loc.IsArabic ? "تشغيل" : "Active")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-90 px-2 py-1 small rounded-pill">
                                                <i class="bi bi-pause-circle-fill me-1"></i> @(Loc.IsArabic ? "متوقفة" : "Inactive")
                                            </span>
                                        }
                                    </div>
                                    <div class="position-absolute bottom-0 start-0 p-2 w-100" style="background: linear-gradient(transparent, rgba(15, 23, 42, 0.85));">
                                        <div class="d-flex align-items-center text-warning small">
                                            <i class="bi bi-star-fill me-1"></i>
                                            <span class="fw-bold me-1 text-white">@venue.AverageRating.ToString("0.0")</span>
                                            <span class="text-white-50 small">(@venue.TotalReviews @(Loc.IsArabic ? "تقييم" : "reviews"))</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Card Body -->
                                <div class="card-body p-4 d-flex flex-column">
                                    <h5 class="card-title text-dark fw-bold mb-1 text-truncate">@venue.Name</h5>
                                    <div class="text-muted small mb-2">
                                        <i class="bi bi-geo-alt me-1 text-danger"></i>@venue.Area, @venue.City
                                    </div>

                                    <!-- Approval Notice if Pending or Rejected -->
                                    @if (venue.ApprovalStatus == CourtBook.Domain.Enums.VenueApprovalStatus.Rejected && !string.IsNullOrEmpty(venue.RejectionReason))
                                    {
                                        <div class="alert alert-danger py-1 px-2 small mb-2" style="font-size: 11px;">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                            <strong>@(Loc.IsArabic ? "سبب الرفض: " : "Rejection Reason: ")</strong>@venue.RejectionReason
                                        </div>
                                    }
                                    else if (venue.ApprovalStatus == CourtBook.Domain.Enums.VenueApprovalStatus.Pending)
                                    {
                                        <div class="alert alert-warning py-1 px-2 small mb-2" style="font-size: 11px;">
                                            <i class="bi bi-clock-history me-1"></i>
                                            @(Loc.IsArabic ? "المنشأة قيد مراجعة الإدارة وستظهر في منصة الحجز فور اعتمادها." : "Under admin review; will become bookable once approved.")
                                        </div>
                                    }

                                    <!-- Sports Pills -->
                                    <div class="d-flex flex-wrap gap-1 mb-3">
                                        @if (venue.Sports.Any())
                                        {
                                            @foreach (var sport in venue.Sports)
                                            {
                                                <span class="badge bg-light text-dark border px-2 py-1 small rounded-pill">
                                                    @Loc.Sport(sport)
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">@(Loc.IsArabic ? "لا توجد ملاعب مضافة" : "No courts added")</span>
                                        }
                                    </div>

                                    <!-- Facility Stats Mini-Grid -->
                                    <div class="row g-2 text-center p-2 rounded-3 mb-3 mt-auto bg-light border border-light-subtle">
                                        <div class="col-6 border-end">
                                            <div class="text-muted" style="font-size: 0.75rem;">@Loc["Owner.Kpi.Courts"]</div>
                                            <div class="text-dark fw-bold">@venue.TotalCourts</div>
                                        </div>
                                        <div class="col-6">
                                            <div class="text-muted" style="font-size: 0.75rem;">@Loc["Owner.Kpi.Upcoming"]</div>
                                            <div class="text-warning fw-bold">@venue.UpcomingBookingsCount</div>
                                        </div>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="d-flex gap-2">
                                        <a href="/Owner/Venues/Manage?id=@venue.Id" class="ps-btn ps-btn-primary flex-grow-1 rounded-pill py-2 small fw-semibold text-center">
                                            <i class="bi bi-gear-fill me-1"></i> @Loc["Owner.Venues.ManageBtn"]
                                        </a>
                                        <a href="/Venues/Details?id=@venue.Id" target="_blank" class="btn btn-outline-secondary rounded-pill px-3 py-2 small" title="@(Loc.IsArabic ? "معاينة الصفحة العامة" : "Preview Public Page")">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>
