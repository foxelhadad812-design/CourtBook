@page "/Owner/Venues"
@model CourtBook.Web.Pages.Owner.Venues.IndexModel
@{
    ViewData["Title"] = "Managed Facilities — PlaySpot Owner";
}

<div class="owner-venues-page py-4">
    <div class="container-xl">
        @if (!Model.IsOwner)
        {
            <div class="card border-0 shadow-lg text-center p-5 my-5" style="background: rgba(22, 27, 34, 0.9); border: 1px solid rgba(239, 68, 68, 0.3) !important; border-radius: 20px;">
                <div class="display-1 text-danger mb-3">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h2 class="text-white fw-bold mb-2">Access Restricted</h2>
                <p class="text-secondary mx-auto mb-4" style="max-width: 500px;">
                    This section is reserved for verified sports facility owners. To register as an owner or manage your venues, please log in with an owner account.
                </p>
                <div>
                    <a href="/Login?returnUrl=/Owner/Venues" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Sign In as Facility Owner
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Page Header -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 border-bottom border-dark">
                <div>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-1">
                            <li class="breadcrumb-item"><a href="/Owner" class="text-secondary text-decoration-none">Dashboard</a></li>
                            <li class="breadcrumb-item active text-white" aria-current="page">Facilities</li>
                        </ol>
                    </nav>
                    <h1 class="h3 text-white fw-bold mb-1">Managed Sports Facilities</h1>
                    <p class="text-secondary mb-0 small">Overview of all your sports venues, courts, and operational status.</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="/Owner" class="btn btn-outline-secondary rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i> Dashboard
                    </a>
                    <a href="/Owner/Venues/Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
                        <i class="bi bi-plus-circle me-1"></i> Add Facility
                    </a>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger d-flex align-items-center rounded-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div>@Model.ErrorMessage</div>
                </div>
            }

            <!-- KPI Mini Bar -->
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-lg-3">
                    <div class="card border-0 p-3 h-100" style="background: rgba(22, 27, 34, 0.7); border: 1px solid rgba(255,255,255,0.08) !important; border-radius: 14px;">
                        <div class="text-secondary small fw-medium">Total Facilities</div>
                        <div class="h3 text-white fw-bold mb-0 mt-1">@Model.Venues.Count</div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="card border-0 p-3 h-100" style="background: rgba(22, 27, 34, 0.7); border: 1px solid rgba(255,255,255,0.08) !important; border-radius: 14px;">
                        <div class="text-secondary small fw-medium">Active Facilities</div>
                        <div class="h3 text-success fw-bold mb-0 mt-1">@Model.Venues.Count(v => v.IsActive)</div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="card border-0 p-3 h-100" style="background: rgba(22, 27, 34, 0.7); border: 1px solid rgba(255,255,255,0.08) !important; border-radius: 14px;">
                        <div class="text-secondary small fw-medium">Total Bookable Courts</div>
                        <div class="h3 text-info fw-bold mb-0 mt-1">@Model.Venues.Sum(v => v.TotalCourts)</div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="card border-0 p-3 h-100" style="background: rgba(22, 27, 34, 0.7); border: 1px solid rgba(255,255,255,0.08) !important; border-radius: 14px;">
                        <div class="text-secondary small fw-medium">Upcoming Reservations</div>
                        <div class="h3 text-warning fw-bold mb-0 mt-1">@Model.Venues.Sum(v => v.UpcomingBookingsCount)</div>
                    </div>
                </div>
            </div>

            <!-- Facilities Grid -->
            @if (Model.Venues.Count == 0)
            {
                <div class="card border-0 text-center p-5" style="background: rgba(22, 27, 34, 0.6); border: 1px dashed rgba(255,255,255,0.15) !important; border-radius: 20px;">
                    <div class="display-3 text-secondary mb-3"><i class="bi bi-building-add"></i></div>
                    <h4 class="text-white fw-bold mb-2">No Facilities Added Yet</h4>
                    <p class="text-secondary mx-auto mb-4" style="max-width: 450px;">
                        Start listing your sports venue, configure your courts, set your schedule, and begin accepting reservations from players across Egypt.
                    </p>
                    <div>
                        <a href="/Owner/Venues/Create" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                            <i class="bi bi-plus-lg me-1"></i> Register Your First Facility
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var venue in Model.Venues)
                    {
                        var photoUrl = !string.IsNullOrEmpty(venue.PrimaryImageUrl) ? venue.PrimaryImageUrl : "/images/venue.jpg";
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 border-0 shadow-sm overflow-hidden" style="background: rgba(22, 27, 34, 0.85); border: 1px solid rgba(255,255,255,0.1) !important; border-radius: 18px; transition: transform 0.2s ease, border-color 0.2s ease;">
                                <!-- Image Header with Badges -->
                                <div class="position-relative" style="height: 180px; background: #111;">
                                    <img src="@photoUrl" alt="@venue.Name" class="w-100 h-100 object-fit-cover" onerror="this.src='/images/venue.jpg'" />
                                    <div class="position-absolute top-0 end-0 p-2 d-flex gap-1">
                                        @if (venue.IsActive)
                                        {
                                            <span class="badge bg-success bg-opacity-75 backdrop-blur px-2 py-1 small rounded-pill">
                                                <i class="bi bi-check-circle-fill me-1"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-75 backdrop-blur px-2 py-1 small rounded-pill">
                                                <i class="bi bi-pause-circle-fill me-1"></i> Inactive
                                            </span>
                                        }
                                        @if (venue.IsVerified)
                                        {
                                            <span class="badge bg-primary bg-opacity-75 backdrop-blur px-2 py-1 small rounded-pill">
                                                <i class="bi bi-patch-check-fill me-1"></i> Verified
                                            </span>
                                        }
                                    </div>
                                    <div class="position-absolute bottom-0 start-0 p-2 w-100" style="background: linear-gradient(transparent, rgba(15, 23, 42, 0.95));">
                                        <div class="d-flex align-items-center text-warning small">
                                            <i class="bi bi-star-fill me-1"></i>
                                            <span class="fw-bold me-1">@venue.AverageRating.ToString("0.0")</span>
                                            <span class="text-secondary small">(@venue.TotalReviews reviews)</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Card Body -->
                                <div class="card-body p-3 d-flex flex-column">
                                    <h5 class="card-title text-white fw-bold mb-1 text-truncate">@venue.Name</h5>
                                    <div class="text-secondary small mb-3">
                                        <i class="bi bi-geo-alt me-1 text-primary"></i>@venue.Area, @venue.City
                                    </div>

                                    <!-- Sports Pills -->
                                    <div class="d-flex flex-wrap gap-1 mb-3">
                                        @if (venue.Sports.Any())
                                        {
                                            @foreach (var sport in venue.Sports)
                                            {
                                                <span class="badge bg-dark border border-secondary text-light px-2 py-1 small rounded-pill">
                                                    @sport
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-secondary small fst-italic">No courts added</span>
                                        }
                                    </div>

                                    <!-- Facility Stats Mini-Grid -->
                                    <div class="row g-2 text-center p-2 rounded-3 mb-3 mt-auto" style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255,255,255,0.05);">
                                        <div class="col-6 border-end border-dark">
                                            <div class="text-secondary" style="font-size: 0.75rem;">Courts</div>
                                            <div class="text-white fw-bold">@venue.TotalCourts</div>
                                        </div>
                                        <div class="col-6">
                                            <div class="text-secondary" style="font-size: 0.75rem;">Upcoming</div>
                                            <div class="text-warning fw-bold">@venue.UpcomingBookingsCount</div>
                                        </div>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="d-flex gap-2">
                                        <a href="/Owner/Venues/Manage?id=@venue.Id" class="btn btn-primary flex-grow-1 rounded-pill py-2 small fw-semibold">
                                            <i class="bi bi-gear-fill me-1"></i> Manage
                                        </a>
                                        <a href="/Venues/Details/@venue.Id" target="_blank" class="btn btn-outline-secondary rounded-pill px-3 py-2 small" title="Preview Public Page">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>
